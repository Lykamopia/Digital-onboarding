// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  signature          String?
  hashedPassword     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  status             String    @default("active")
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)

  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?

  roleId   String?
  role     Role?   @relation(fields: [roleId], references: [id])

  officeId      String?
  office        Office?      @relation(fields: [officeId], references: [id])
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  divisionId    String?
  division      Division?    @relation(fields: [divisionId], references: [id])
  districtId    String?
  district      District?    @relation(fields: [districtId], references: [id])
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])

  sentMemos           Memo[]       @relation("SentMemos")
  receivedMemosTo     Memo[]       @relation("ReceivedMemosTo")
  receivedMemosCc     Memo[]       @relation("ReceivedMemosCc")
  currentMemoHolder   Memo[]       @relation("CurrentHolder")
  previousMemoHolder  Memo[]       @relation("PreviousHolders")
  acknowledgedMemos   Memo[]       @relation("AcknowledgedBy")
  activities          Activity[]
  archivedMemos       Memo[]       @relation("ArchivedBy")
  favoritedMemos      Memo[]       @relation("FavoritedBy")
  flaggedMemos        Memo[]       @relation("FlaggedBy")
  
  accounts Account[]
  sessions Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model Memo {
  id                    String     @id @default(cuid())
  memo_reference_number String?    @unique
  subject               String
  body                  String     @db.Text
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  status                String     @default("draft") // draft, sent, archived, scheduled
  scheduledFor          DateTime?

  fromId   String
  from     User   @relation("SentMemos", fields: [fromId], references: [id], onDelete: Restrict)

  to       User[] @relation("ReceivedMemosTo")
  cc       User[] @relation("ReceivedMemosCc")

  current_holderId  String?
  current_holder    User?    @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)
  previous_holders  User[]   @relation("PreviousHolders")
  acknowledgedBy    User[]   @relation("AcknowledgedBy")

  archivedBy   User[] @relation("ArchivedBy")
  favoritedBy  User[] @relation("FavoritedBy")
  flaggedBy    User[] @relation("FlaggedBy")

  attachments Attachment[]
  activity    Activity[]
  labels      Label[]

  replyToId String?
  replyTo   Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Memo[]  @relation("Replies")

  forwardFromId String?
  forwardFrom   Memo?   @relation("Forwards", fields: [forwardFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forwards      Memo[]  @relation("Forwards")
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  permissions String
  users       User[]
}

model Office {
  id      String   @id @default(cuid())
  name    String   @unique
  code    String   @unique
  type    String   @default("branch_office") // head_office, division_office, branch_office
  users   User[]
  departments Department[]
  districts   District[]
}

model Department {
  id          String     @id @default(cuid())
  name        String
  code        String
  officeId    String
  office      Office     @relation(fields: [officeId], references: [id], onDelete: Restrict)
  divisions   Division[]
  users       User[]
  @@unique([name, officeId])
}

model Division {
  id            String     @id @default(cuid())
  name          String
  code          String
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users         User[]
  @@unique([name, departmentId])
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office   @relation(fields: [officeId], references: [id], onDelete: Restrict)
  branches Branch[]
  users    User[]
  @@unique([name, officeId])
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String
  districtId  String
  district    District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  users       User[]
  @@unique([name, districtId])
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String
  type  String @default("USER") // SYSTEM or USER
  memos Memo[]
}
