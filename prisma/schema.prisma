
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  hashedPassword     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  status             String?   @default("active")
  mustChangePassword Boolean   @default(false)
  signature          String?

  // An user can be associated with one office
  officeId    String?
  office      Office?     @relation(fields: [officeId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  divisionId String?
  division     Division?   @relation(fields: [divisionId], references: [id])

  districtId String?
  district     District?   @relation(fields: [districtId], references: [id])

  branchId String?
  branch     Branch?     @relation(fields: [branchId], references: [id])

  // An user can have one role
  roleId      String?
  role        Role?       @relation(fields: [roleId], references: [id])

  accounts           Account[]
  sessions           Session[]
  sentMemos          Memo[]         @relation("SentMemos")
  receivedMemos      Memo[]         @relation("ReceivedMemos")
  ccMemos            Memo[]         @relation("CCMemos")
  currentMemos       Memo[]         @relation("CurrentMemoHolder")
  previousMemos      Memo[]         @relation("PreviousMemoHolders")
  acknowledgedMemos  Memo[]         @relation("AcknowledgedMemos")
  archivedMemos      Memo[]         @relation("ArchivedMemos")
  favoritedMemos     Memo[]         @relation("FavoritedMemos")
  activities         Activity[]
}

model Role {
    id          String @id @default(cuid())
    name        String @unique
    permissions String
    users       User[]
}

model Office {
  id            String       @id @default(cuid())
  name          String
  code          String
  type          String
  users         User[]
  departments   Department[]
  districts     District[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
  users     User[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]
  users    User[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
}

model Memo {
  id                      String       @id @default(cuid())
  memo_reference_number   String?      @unique
  fromId                  String
  from                    User         @relation("SentMemos", fields: [fromId], references: [id])
  to                      User[]       @relation("ReceivedMemos")
  cc                      User[]       @relation("CCMemos")
  subject                 String
  body                    String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  status                  String       // "draft", "sent", "acknowledged", "archived", "scheduled"
  isFlagged               Boolean      @default(false)

  // Tracking current and previous holders for forwarding/delegation
  current_holderId        String?
  current_holder          User?        @relation("CurrentMemoHolder", fields: [current_holderId], references: [id])
  previous_holders        User[]       @relation("PreviousMemoHolders")
  
  attachments             Attachment[]
  activity                Activity[]

  acknowledgedBy          User[]       @relation("AcknowledgedMemos")
  archivedBy              User[]       @relation("ArchivedMemos")
  favoritedBy             User[]       @relation("FavoritedMemos")
  
  // For replies
  replyToId               String?
  replyTo                 Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies                 Memo[]       @relation("Replies")

  // For scheduled memos
  scheduledFor            DateTime?
  
  labels                  Label[]
}

model Attachment {
  id     String @id @default(cuid())
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
  name   String
  url    String
  type   String
  size   Int
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String   // e.g., "sent", "viewed", "commented", "forwarded", "archived", "unarchived"
  details   String?
  timestamp DateTime @default(now())
}

model Label {
    id    String @id @default(cuid())
    name  String @unique
    color String
    type  String // SYSTEM or USER
    memos Memo[]
}
