
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memo {
  id                      String    @id @default(cuid())
  memo_reference_number   String?   @unique
  subject                 String
  body                    String    @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  status                  String    @default("draft") // draft, sent, scheduled
  fromId                  String
  from                    User      @relation("AuthoredMemos", fields: [fromId], references: [id])
  to                      User[]    @relation("MemosTo")
  cc                      User[]    @relation("MemosCc")
  current_holderId        String?
  current_holder          User?     @relation("CurrentHolder", fields: [current_holderId], references: [id"])
  previous_holders        User[]    @relation("PreviousHolders")
  acknowledgedBy          User[]    @relation("AcknowledgedMemos")
  favoritedBy             User[]    @relation("FavoriteMemos")
  archivedBy              User[]    @relation("ArchivedMemos")
  attachments             Attachment[]
  activity                Activity[]
  replies                 Memo[]    @relation("MemoReplies")
  replyTo                 Memo?     @relation("MemoReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId               String?
  labels                  Label[]
  scheduledFor            DateTime?
}

model Label {
  id      String @id @default(cuid())
  name    String @unique
  color   String
  type    String // SYSTEM or USER
  memos   Memo[]
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model User {
  id                      String       @id @default(cuid())
  name                    String?
  email                   String?      @unique
  emailVerified           DateTime?
  image                   String?
  avatar                  String?
  hashedPassword          String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  mustChangePassword      Boolean      @default(true)
  status                  String       @default("active") // active, inactive
  roleId                  String?
  role                    Role?        @relation(fields: [roleId], references: [id])
  officeId                String?
  office                  Office?      @relation(fields: [officeId], references: [id])
  authoredMemos           Memo[]       @relation("AuthoredMemos")
  memosTo                 Memo[]       @relation("MemosTo")
  memosCc                 Memo[]       @relation("MemosCc")
  memosAsCurrentHolder    Memo[]       @relation("CurrentHolder")
  memosAsPreviousHolder   Memo[]       @relation("PreviousHolders")
  acknowledgedMemos       Memo[]       @relation("AcknowledgedMemos")
  favoriteMemos           Memo[]       @relation("FavoriteMemos")
  archivedMemos           Memo[]       @relation("ArchivedMemos")
  activity                Activity[]
  accounts                Account[]
  sessions                Session[]
}

model Office {
    id          String @id @default(cuid())
    name        String
    code        String
    type        String // head_office, division_office, branch_office, division, branch
    departments Department[]
    districts   District[]
    users       User[]
}

model Department {
    id        String     @id @default(cuid())
    name      String
    code      String
    officeId  String
    office    Office     @relation(fields: [officeId], references: [id])
    divisions Division[]
}

model District {
    id        String   @id @default(cuid())
    name      String
    code      String
    officeId  String
    office    Office   @relation(fields: [officeId], references: [id])
    branches  Branch[]
}

model Division {
    id           String     @id @default(cuid())
    name         String
    code         String
    departmentId String
    department   Department @relation(fields: [departmentId], references: [id])
}

model Branch {
    id         String   @id @default(cuid())
    name       String
    code       String
    districtId String
    district   District @relation(fields: [districtId], references: [id])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String
  users       User[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
