// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  hashedPassword String?
  avatar         String?
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  mustChangePassword Boolean   @default(false)
  
  status         String        @default("active") // active, inactive

  roleId         String
  role           Role          @relation(fields: [roleId], references: [id])

  officeId       String?
  office         Office?       @relation(fields: [officeId], references: [id])

  sentMemos      Memo[]        @relation("SentMemos")
  memosTo        Memo[]        @relation("MemosTo")
  memosCc        Memo[]        @relation("MemosCc")
  
  currentMemos   Memo[]        @relation("CurrentHolder")
  heldMemos      Memo[]        @relation("PreviousHolders")

  acknowledgedMemos Memo[]    @relation("AcknowledgedMemos")
  archivedMemos     Memo[]    @relation("ArchivedMemos")
  favoritedMemos    Memo[]    @relation("FavoritedMemos")
  
  activities     Activity[]

  // Digital Signature
  signature             String?
  acknowledgementType   AcknowledgementType @default(BADGE)


  @@map("users")
}

model Memo {
  id                   String     @id @default(cuid())
  memo_reference_number String?    @unique
  subject              String
  body                 String     @db.Text
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  status               String // draft, sent, scheduled, etc.
  isFlagged            Boolean    @default(false)

  fromId               String
  from                 User       @relation("SentMemos", fields: [fromId], references: [id])

  current_holderId     String?
  current_holder       User?      @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders     User[]     @relation("PreviousHolders")

  to                   User[]     @relation("MemosTo")
  cc                   User[]     @relation("MemosCc")
  
  acknowledgedBy       User[]     @relation("AcknowledgedMemos")
  archivedBy           User[]     @relation("ArchivedMemos")
  favoritedBy          User[]     @relation("FavoritedMemos")

  attachments          Attachment[]
  activity             Activity[]
  labels               Label[]

  replies              Memo[]     @relation("Replies")
  replyTo              Memo?      @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId            String?

  scheduledFor         DateTime?
}


model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  details   String?
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // comma-separated list of permissions
  users       User[]
}

model Office {
    id   String @id @default(cuid())
    name String
    code String?
    type String // head_office, division_office, branch_office, division, branch

    departments Department[]
    districts   District[]
    users       User[]
}

model Department {
    id   String @id @default(cuid())
    name String @unique
    code String?

    officeId String
    office   Office @relation(fields: [officeId], references: [id])

    divisions Division[]
}

model Division {
    id   String @id @default(cuid())
    name String @unique
    code String?
    
    departmentId String
    department   Department @relation(fields: [departmentId], references: [id])
}

model District {
    id   String @id @default(cuid())
    name String @unique
    code String?
    
    officeId String
    office   Office @relation(fields: [officeId], references: [id])

    branches Branch[]
}

model Branch {
    id   String @id @default(cuid())
    name String @unique
    code String?

    districtId String
    district   District @relation(fields: [districtId], references: [id])
}

model Label {
    id    String @id @default(cuid())
    name  String @unique
    color String
    type  String // SYSTEM or USER
    memos Memo[]
}

enum AcknowledgementType {
  BADGE
  SIGNATURE
}
