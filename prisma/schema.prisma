
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  avatar         String?
  status         String    @default("active") // active, inactive
  accounts       Account[]
  sessions       Session[]
  sentMemos      Memo[]    @relation("MemoFrom")
  receivedMemos  Memo[]    @relation("MemoTo")
  ccMemos        Memo[]    @relation("MemoCc")
  currentMemo    Memo[]    @relation("CurrentHolder")
  previousMemos  Memo[]    @relation("PreviousHolders")
  acknowledged   Memo[]    @relation("AcknowledgedBy")
  archivedMemos  Memo[]    @relation("ArchivedBy")
  activities     Activity[]

  roleId   String?
  role     Role?   @relation(fields: [roleId], references: [id])
  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  @@index([officeId])
  @@index([roleId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Division {
  id         String       @id @default(cuid())
  name       String       @unique
  code       String       @unique
  departments Department[]
}

model Department {
  id         String     @id @default(cuid())
  name       String
  code       String     @unique
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id])
  offices    Office[]

  @@unique([name, divisionId])
  @@index([divisionId])
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]

  @@unique([name, departmentId])
  @@index([departmentId])
}

model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String       @unique
  subject               String
  body                  String       @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  status                String // e.g., 'draft', 'sent', 'read', 'acknowledged'
  fromId                String
  from                  User         @relation("MemoFrom", fields: [fromId], references: [id])
  to                    User[]       @relation("MemoTo")
  cc                    User[]       @relation("MemoCc")
  attachments           Attachment[]
  activity              Activity[]
  current_holderId      String?
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders      User[]       @relation("PreviousHolders")
  acknowledgedBy        User[]       @relation("AcknowledgedBy")
  replyToId             String?
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]       @relation("Replies")
  archivedBy            User[]       @relation("ArchivedBy")

  @@index([fromId])
  @@index([current_holderId])
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String @db.Text
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // 'sent', 'viewed', 'commented', 'forwarded', 'acknowledged', 'created'
  timestamp DateTime @default(now())
  details   String?

  @@index([memoId])
  @@index([actorId])
}

enum Permission {
  view_dashboard
  manage_memos
  view_admin
  manage_divisions
  manage_departments
  manage_offices
  manage_users
  manage_roles
  manage_archive
}
