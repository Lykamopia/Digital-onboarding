
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  avatar                String?
  signature             String?
  hashedPassword        String?
  status                String                 @default("active") // active, inactive
  onboardingCompleted   Boolean                @default(false)
  tokenVersion          Int                    @default(0)
  failedLoginAttempts   Int                    @default(0)
  lockoutUntil          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  roleId                String?
  officeId              String?
  departmentId          String?
  divisionId            String?
  districtId            String?
  branchId              String?
  memosSent             Memo[]                 @relation("MemosSent")
  memosReceived         Memo[]                 @relation("MemosReceived")
  memosCc               Memo[]                 @relation("MemosCc")
  memosAcknowledged     Memo[]                 @relation("MemosAcknowledged")
  memosArchived         Memo[]                 @relation("MemosArchived")
  memosFavorited        Memo[]                 @relation("MemosFavorited")
  memosFlagged          Memo[]                 @relation("MemosFlagged")
  memosAsCurrentHolder  Memo[]                 @relation("MemoCurrentHolder")
  memosAsPreviousHolder Memo[]                 @relation("MemoPreviousHolders")
  activities            Activity[]
  delegations           Delegation[]           @relation("Delegator")
  delegatedTo           Delegation[]           @relation("Delegate")
  role                  Role?                  @relation(fields: [roleId], references: [id])
  office                Office?                @relation(fields: [officeId], references: [id])
  department            Department?            @relation(fields: [departmentId], references: [id])
  division              Division?              @relation(fields: [divisionId], references: [id])
  district              District?              @relation(fields: [districtId], references: [id])
  branch                Branch?                @relation(fields: [branchId], references: [id])
  securityLogs                    SecurityLog[]
  customerOnboardingsReviewed     CustomerOnboarding[]           @relation("CustomerOnboardingReviewer")
  customerOnboardingsMaker        CustomerOnboarding[]           @relation("CustomerOnboardingMaker")
  customerOnboardingsSubmitted    CustomerOnboarding[]           @relation("CustomerOnboardingSubmitter")
  customerOnboardingAuditLogs     CustomerOnboardingAuditLog[]   @relation("CustomerOnboardingAuditActor")

  @@index([roleId])
  @@index([officeId])
  @@index([departmentId])
  @@index([divisionId])
  @@index([districtId])
  @@index([branchId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Office {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  type        String       @default("branch_office") // branch_office, division_office
  users       User[]
  departments Department[]
  districts   District[]
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
  users     User[]
}

model Division {
  id           String     @id @default(cuid())
  name         String     @unique
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model District {
    id        String   @id @default(cuid())
    name      String   @unique
    code      String   @unique
    officeId  String
    office    Office   @relation(fields: [officeId], references: [id])
    branches  Branch[]
    users     User[]
}

model Branch {
    id         String   @id @default(cuid())
    name       String   @unique
    code       String   @unique
    districtId String
    district   District @relation(fields: [districtId], references: [id])
    users      User[]
}


model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String?      @unique
  subject               String
  body                  String       @db.Text
  status                String       @default("draft") // draft, sent, scheduled
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  scheduledFor          DateTime?
  fromId                String
  from                  User         @relation("MemosSent", fields: [fromId], references: [id])
  to                    User[]       @relation("MemosReceived")
  cc                    User[]       @relation("MemosCc")
  attachments           Attachment[]
  activity              Activity[]
  current_holderId      String?
  current_holder        User?        @relation("MemoCurrentHolder", fields: [current_holderId], references: [id])
  previous_holders      User[]       @relation("MemoPreviousHolders")
  acknowledgedBy        User[]       @relation("MemosAcknowledged")
  archivedBy            User[]       @relation("MemosArchived")
  favoritedBy           User[]       @relation("MemosFavorited")
  flaggedBy             User[]       @relation("MemosFlagged")
  labels                Label[]
  replyToId             String?
  replyTo               Memo?        @relation("MemoReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]       @relation("MemoReplies")
  assignedFromId        String?

  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
}

model Attachment {
  id        String   @id @default(cuid())
  memoId    String
  name      String
  url       String
  size      Int
  type      String
  createdAt DateTime @default(now())
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  actorId   String
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([memoId])
  @@index([actorId])
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String
  type  String @default("USER") // USER or SYSTEM
  memos Memo[]
}

model Delegation {
  id           String   @id @default(cuid())
  delegatorId  String
  delegateId   String
  permissions  String // Comma-separated list of permissions
  createdAt    DateTime @default(now())
  delegator    User     @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate     User     @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)

  @@unique([delegatorId, delegateId])
  @@index([delegatorId])
  @@index([delegateId])
}

model PasswordResetToken {
  email     String   @id
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  from             String
  to               String
  cc               String?
  subject          String
  body             String   @db.Text
  status           String // 'sent' or 'failed'
  triggerEvent     String?
  relatedEntityId  String?
  errorMessage     String?
  messageId        String?
}

model SecurityLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  actorId    String?
  event      String
  severity   String // e.g., INFO, WARN, CRITICAL
  ipAddress  String?
  userAgent  String?
  details    String   @db.Text
  targetId   String? // ID of the entity being acted upon (e.g., user id, role id)
  targetType String? // Type of the entity (e.g., 'User', 'Role')

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([event])
  @@index([timestamp])
}

// ─────────────────────────────────────────────────────────────
// Customer Onboarding Integration
// ─────────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  MAKER_APPROVED
  MAKER_REJECTED
  APPROVED
  REJECTED
  REQUIRES_REVIEW
  RESUBMITTED
}

model CustomerOnboarding {
  id               String         @id @default(cuid())
  // Mnemonic lookup for idempotency (non-unique to allow linked resubmissions)
  mnemonic         String
  approvalStatus   ApprovalStatus @default(PENDING)

  // Link to previous attempt for full audit traceability
  parentCustomerId String?
  parentCustomer   CustomerOnboarding? @relation("Resubmissions", fields: [parentCustomerId], references: [id], onDelete: SetNull)
  resubmissions    CustomerOnboarding[] @relation("Resubmissions")

  // Identity
  shortName        String
  fullName1        String
  fullName2        String?
  title            String
  givenName        String
  familyName       String
  gender           String
  dateOfBirth      String
  maritalStatus    String
  motherName       String?
  nationality      String
  // Original Identity Fields (Preserved for API & Integrations)
  legalIdNumber    String?   @map("legal_id_number")
  nationalIDNumber String?   @map("national_id_number")
  // Derived Field (Internal simplified access & Dashboard display alias)
  psuToken         String?   @map("psu_token")
  picture          String?   @db.Text
  payloadHash      String?   @map("payload_hash")

  // Address
  street           String
  townCity         String
  country          String
  houseNo          String?
  flatNo           String?
  woreda           String?
  kebele           String?
  subcity          String?
  region           String

  // Contact
  phoneNumbersRes      String?
  mobilePhoneNumbers   String?
  language             String

  // Legal ID
  documentName     String
  nameOnID         String
  issueAuthority   String
  issueDate        String
  expirationDate   String

  // Banking / Classification
  sector           String
  accountOfficer   String
  industry         String
  target           String
  customerStatus   String
  residence        String
  customerType     String
  secureMessage    String?

  // Employment & Financials
  occupation       String?
  employersName    String?
  netMonthlyIn     String?

  // Downstream transfer metadata
  forwardedAt      DateTime?
  forwardError     String?   @db.Text
  forwardResponse  Json?

  // Final Review (Checker)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?   @db.Text

  // Initial Review (Maker)
  makerReviewedById String?
  makerReviewedAt   DateTime?
  makerReviewNote   String?   @db.Text

  // Submitter
  submittedById    String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  makerReviewedBy  User?     @relation("CustomerOnboardingMaker", fields: [makerReviewedById], references: [id], onDelete: SetNull)
  reviewedBy       User?     @relation("CustomerOnboardingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedBy      User?     @relation("CustomerOnboardingSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  auditLogs        CustomerOnboardingAuditLog[]

  @@index([approvalStatus])
  @@index([mnemonic])
  @@index([parentCustomerId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([makerReviewedById])
  @@index([createdAt])
  @@index([mobilePhoneNumbers])
  @@index([fullName1])
  @@index([givenName])
  @@index([familyName])
}

model CustomerOnboardingAuditLog {
  id                   String             @id @default(cuid())
  customerOnboardingId String
  actorId              String?
  action               String             // SUBMITTED, APPROVED, REJECTED, FORWARDED, FORWARD_FAILED
  details              String?            @db.Text
  ipAddress            String?
  userAgent            String?
  timestamp            DateTime           @default(now())

  customerOnboarding   CustomerOnboarding @relation(fields: [customerOnboardingId], references: [id], onDelete: Cascade)
  actor                User?              @relation("CustomerOnboardingAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([customerOnboardingId])
  @@index([actorId])
  @@index([timestamp])
}
