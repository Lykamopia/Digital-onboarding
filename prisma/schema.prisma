
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  hashedPassword     String?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  status             String    @default("active")
  
  accounts           Account[]
  sessions           Session[]
  
  officeId           String?
  office             Office?   @relation(fields: [officeId], references: [id])
  
  roleId             String?
  role               Role?     @relation(fields: [roleId], references: [id])
  
  sentMemos          Memo[]    @relation("SentMemos")
  memosTo            Memo[]    @relation("MemosTo")
  memosCc            Memo[]    @relation("MemosCc")
  
  currentMemoHolder  Memo[]    @relation("CurrentHolder")
  previousMemoHolder Memo[]    @relation("PreviousHolders")
  
  acknowledgedMemos  Memo[]    @relation("AcknowledgedBy")
  archivedMemos      Memo[]    @relation("ArchivedBy")
  
  activity           Activity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String // comma-separated list of permissions
  users       User[]
}

model Division {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  departments Department[]
}

model Department {
  id         String    @id @default(cuid())
  name       String
  code       String
  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  offices    Office[]
  
  @@unique([divisionId, name])
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
  
  @@unique([departmentId, name])
}

model Memo {
  id                    String     @id @default(cuid())
  memo_reference_number String
  subject               String
  body                  String     @db.Text
  status                String     // e.g., 'draft', 'sent', 'acknowledged'
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  
  fromId                String
  from                  User       @relation("SentMemos", fields: [fromId], references: [id])

  to                    User[]     @relation("MemosTo")
  cc                    User[]     @relation("MemosCc")
  
  current_holderId      String?
  current_holder        User?      @relation("CurrentHolder", fields: [current_holderId], references: [id])
  
  previous_holders      User[]     @relation("PreviousHolders")
  
  acknowledgedBy        User[]     @relation("AcknowledgedBy")
  archivedBy            User[]     @relation("ArchivedBy")

  attachments           Attachment[]
  activity              Activity[]
  
  replyToId             String?
  replyTo               Memo?      @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]     @relation("Replies")

  @@index([fromId])
  @@index([current_holderId])
}

model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String @db.Text
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String     @id @default(cuid())
  memoId    String
  memo      Memo       @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User       @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String     // e.g., 'sent', 'viewed', 'acknowledged', 'commented', 'forwarded'
  details   String?
  timestamp DateTime   @default(now())
}
