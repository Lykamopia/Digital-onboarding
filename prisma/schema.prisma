// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  mustChangePassword Boolean   @default(true)
  status             String    @default("active") // active, inactive
  avatar             String?
  signature          String?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  sentMemos      Memo[] @relation("SentMemos")
  receivedMemos  Memo[] @relation("ToRecipients")
  ccMemos        Memo[] @relation("CcRecipients")
  currentMemos   Memo[] @relation("CurrentMemoHolder")
  heldMemos      Memo[] @relation("PreviousMemoHolders")
  archivedMemos  Memo[] @relation("ArchivedMemos")
  acknowledged   Memo[] @relation("AcknowledgedBy")
  favoritedMemos Memo[] @relation("FavoritedMemos")
  activities     Activity[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // comma-separated list of permissions
  users       User[]
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String
  type  String @default("USER") // SYSTEM or USER

  memos Memo[]
}

model Office {
  id      String @id @default(cuid())
  name    String
  code    String
  type    String // 'division_office', 'branch_office', 'head_office', 'division', 'branch'

  users       User[]
  departments Department[]
  districts   District[]
}

model Department {
  id       String     @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}


model District {
  id       String     @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office     @relation(fields: [officeId], references: [id])
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}


model Memo {
  id                    String    @id @default(cuid())
  memo_reference_number String?   @unique
  subject               String
  body                  String    @db.Text
  status                String    // "draft", "sent", "scheduled", "archived"
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  isFlagged             Boolean   @default(false)

  fromId String
  from   User   @relation("SentMemos", fields: [fromId], references: [id])

  to    User[] @relation("ToRecipients")
  cc    User[] @relation("CcRecipients")

  attachments Attachment[]
  activity      Activity[]

  current_holderId String?
  current_holder   User?   @relation("CurrentMemoHolder", fields: [current_holderId], references: [id], onDelete: SetNull)

  previous_holders User[] @relation("PreviousMemoHolders")
  
  acknowledgedBy User[] @relation("AcknowledgedBy")
  archivedBy     User[] @relation("ArchivedMemos")
  favoritedBy    User[] @relation("FavoritedMemos")

  labels Label[]

  replyToId String?
  replyTo   Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Memo[]  @relation("Replies")

  scheduledFor DateTime?
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String   // e.g., "sent", "viewed", "commented", "forwarded"
  details   String?  @db.Text
  timestamp DateTime @default(now())
}
