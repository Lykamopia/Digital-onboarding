// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memo {
  id                      String   @id @default(cuid())
  memo_reference_number   String?  @unique
  subject                 String
  body                    String   @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  status                  MemoStatus
  scheduledFor            DateTime?

  fromId                  String
  from                    User     @relation("AuthoredMemos", fields: [fromId], references: [id])
  
  to                      User[]   @relation("RecipientMemos")
  cc                      User[]   @relation("CcMemos")
  
  current_holderId        String?
  current_holder          User?    @relation("CurrentHolder", fields: [current_holderId], references: [id])
  
  previous_holders        User[]   @relation("PreviousHolders")
  acknowledgedBy          User[]   @relation("AcknowledgedMemos")

  memosAsCurrentHolder    User[]   @relation("CurrentHolder")

  attachments             Attachment[]
  activity                Activity[]

  replies                 Memo[] @relation("MemoReplies")
  replyToId               String?
  replyTo                 Memo? @relation("MemoReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  archivedBy              User[] @relation("ArchivedMemos")
  favoritedBy             User[] @relation("FavoriteMemos")

  labels                  Label[]  @relation("MemoLabels")

  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
}

model Attachment {
  id      String @id @default(cuid())
  name    String
  url     String
  type    String
  size    Int
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())
  
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([memoId])
  @@index([actorId])
}


enum MemoStatus {
  draft
  sent
  scheduled
}

model User {
  id                  String   @id @default(cuid())
  name                String?
  email               String?  @unique
  emailVerified       DateTime?
  image               String?
  avatar              String?
  hashedPassword      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  mustChangePassword  Boolean  @default(false)
  status              String   @default("active") // active, inactive

  roleId              String?
  role                Role?    @relation(fields: [roleId], references: [id])
  
  officeId            String?
  office              Office?  @relation(fields: [officeId], references: [id])

  authoredMemos       Memo[]   @relation("AuthoredMemos")
  receivedMemos       Memo[]   @relation("RecipientMemos")
  ccMemos             Memo[]   @relation("CcMemos")
  acknowledgedMemos   Memo[]   @relation("AcknowledgedMemos")
  memosAsPreviousHolder Memo[] @relation("PreviousHolders")
  
  activities          Activity[]
  
  archivedMemos       Memo[]   @relation("ArchivedMemos")
  favoriteMemos       Memo[]   @relation("FavoriteMemos")
  createdLabels       Label[]  @relation("UserCreatedLabels")
}

model Office {
    id          String   @id @default(cuid())
    name        String   @unique
    code        String   @unique
    type        String   // e.g. division_office, branch_office, division, branch
    
    users       User[]
    departments Department[]
    districts   District[]
}

model Department {
    id          String   @id @default(cuid())
    name        String   @unique
    code        String   @unique
    officeId    String
    office      Office   @relation(fields: [officeId], references: [id])
    divisions   Division[]
}

model Division {
    id            String     @id @default(cuid())
    name          String     @unique
    code          String     @unique
    departmentId  String
    department    Department @relation(fields: [departmentId], references: [id])
}

model District {
    id       String   @id @default(cuid())
    name     String   @unique
    code     String   @unique
    officeId String
    office   Office   @relation(fields: [officeId], references: [id])
    branches Branch[]
}

model Branch {
    id         String   @id @default(cuid())
    name       String   @unique
    code       String   @unique
    districtId String
    district   District @relation(fields: [districtId], references: [id])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String?
  users       User[]
}

model Label {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#71717a") 
  type      LabelType @default(USER)
  creatorId String?
  creator   User?    @relation("UserCreatedLabels", fields: [creatorId], references: [id], onDelete: SetNull)
  memos     Memo[]   @relation("MemoLabels")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LabelType {
  SYSTEM
  USER
}
