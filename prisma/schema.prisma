
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  hashedPassword      String?
  avatar              String?
  signature           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  status              String    @default("active")
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int       @default(0)
  onboardingCompleted Boolean   @default(false)

  officeId    String?
  departmentId String?
  divisionId  String?
  districtId  String?
  branchId    String?
  roleId      String?

  role       Role?       @relation(fields: [roleId], references: [id])
  office     Office?     @relation(fields: [officeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  division   Division?   @relation(fields: [divisionId], references: [id])
  district   District?   @relation(fields: [districtId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])

  sentMemos        Memo[] @relation("SentMemos")
  receivedMemos    Memo[] @relation("ReceivedMemos")
  ccMemos          Memo[] @relation("CcMemos")
  acknowledgedMemos Memo[] @relation("AcknowledgedMemos")
  archivedMemos    Memo[] @relation("ArchivedMemos")
  favoritedMemos   Memo[] @relation("FavoritedMemos")
  flaggedMemos     Memo[] @relation("FlaggedMemos")
  
  currentHolderOf  Memo[] @relation("CurrentHolder")
  previousHolderOf Memo[] @relation("PreviousHolders")

  activities Activity[]

  @@map("users")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]

  @@map("roles")
}

model Office {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  type        String   @default("branch_office")
  users       User[]
  departments Department[]
  districts   District[]

  @@map("offices")
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  users     User[]
  divisions Division[]

  @@map("departments")
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]

  @@map("divisions")
}

model District {
    id       String   @id @default(cuid())
    name     String
    code     String   @unique
    officeId String
    office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
    users    User[]
    branches Branch[]

    @@map("districts")
}

model Branch {
    id         String   @id @default(cuid())
    name       String
    code       String   @unique
    districtId String
    district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
    users      User[]

    @@map("branches")
}

model Label {
  id      String @id @default(cuid())
  name    String @unique
  color   String
  type    String @default("USER") // SYSTEM or USER
  memos   Memo[]

  @@map("labels")
}

model Memo {
  id                    String    @id @default(cuid())
  memo_reference_number String?   @unique
  subject               String
  body                  String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  status                String    @default("draft") // draft, sent, scheduled, archived
  scheduledFor          DateTime?

  fromId String
  from   User   @relation("SentMemos", fields: [fromId], references: [id])

  to User[] @relation("ReceivedMemos")
  cc User[] @relation("CcMemos")

  attachments Attachment[]
  activity    Activity[]
  labels      Label[]

  acknowledgedBy   User[] @relation("AcknowledgedMemos")
  archivedBy       User[] @relation("ArchivedMemos")
  favoritedBy      User[] @relation("FavoritedMemos")
  flaggedBy        User[] @relation("FlaggedMemos")

  current_holderId String?
  current_holder   User?    @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)

  previous_holders User[] @relation("PreviousHolders")
  
  replyToId String?
  replyTo   Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Memo[]  @relation("Replies")

  assignedFromId String?
  assignedFrom   Memo?   @relation("Assignments", fields: [assignedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments    Memo[]  @relation("Assignments")

  @@map("memos")
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int
  url       String
  createdAt DateTime @default(now())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Activity {
  id        String   @id @default(cuid())
  action    String // created, sent, viewed, acknowledged, commented, forwarded
  details   String?
  timestamp DateTime @default(now())
  memoId    String
  actorId   String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])
  ipAddress String?
  userAgent String?

  @@map("activity")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id               String   @id @default(cuid())
  from             String
  to               String
  cc               String?
  subject          String
  body             String
  status           String // sent, failed
  errorMessage     String?
  triggerEvent     String // new_memo, welcome_user, password_reset
  relatedEntityId  String?
  messageId        String?
  createdAt        DateTime @default(now())
  
  @@map("email_logs")
}
