// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  hashedPassword     String?
  avatar             String?
  image              String?
  signature          String?
  mustChangePassword Boolean   @default(true)
  status             String    @default("active") // active, inactive, suspended
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  sentMemos        Memo[] @relation("SentMemos")
  receivedMemos    Memo[] @relation("ReceivedMemos")
  ccMemos          Memo[] @relation("CcMemos")
  currentMemoHolder Memo?  @relation("CurrentMemoHolder")
  previousMemoHolder Memo[] @relation("PreviousMemoHolders")
  acknowledgedMemos Memo[] @relation("AcknowledgedBy")
  archivedMemos    Memo[] @relation("ArchivedBy")
  favoritedMemos   Memo[] @relation("FavoritedBy")
  activities       Activity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// Memo Management Models

model Office {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      String // head_office, division_office, branch_office, division, branch
  departments Department[]
  districts District[]
  users     User[]
}

model Department {
  id       String   @id @default(cuid())
  name     String
  code     String   @unique
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  divisions Division[]
}

model Division {
  id           String @id @default(cuid())
  name         String
  code         String @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String   @unique
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]
}

model Branch {
  id         String @id @default(cuid())
  name       String
  code       String @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}


model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  permissions String?
  users       User[]
}

model Label {
  id      String @id @default(cuid())
  name    String @unique
  color   String
  type    String // SYSTEM or USER
  memos   Memo[]
}

model Memo {
  id                    String    @id @default(cuid())
  memo_reference_number String?   @unique
  subject               String
  body                  String    @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  status                String    // "draft", "sent", "scheduled"
  isFlagged             Boolean   @default(false)

  fromId String
  from   User   @relation("SentMemos", fields: [fromId], references: [id])

  to User[] @relation("ReceivedMemos")
  cc User[] @relation("CcMemos")
  
  // Tracking who currently has the memo for action
  current_holderId String?
  current_holder   User?   @relation("CurrentMemoHolder", fields: [current_holderId], references: [id])
  
  previous_holders User[] @relation("PreviousMemoHolders")
  
  acknowledgedBy User[] @relation("AcknowledgedBy")
  archivedBy     User[] @relation("ArchivedBy")
  favoritedBy    User[] @relation("FavoritedBy")
  
  attachments Attachment[]
  activity    Activity[]
  
  // For threaded replies
  replyToId   String?
  replyTo     Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Memo[]  @relation("Replies")

  // For scheduled memos
  scheduledFor DateTime?

  labels Label[]
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String   // e.g., "sent", "viewed", "commented", "forwarded"
  details   String?
  timestamp DateTime @default(now())
}
