generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  email               String?      @unique
  emailVerified       DateTime?
  image               String?
  avatar              String?
  hashedPassword      String?
  roleId              String?
  status              String       @default("active")
  mustChangePassword  Boolean      @default(true)
  failedLoginAttempts Int          @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int          @default(0)
  signature           String?
  onboardingCompleted Boolean      @default(false)
  officeId            String?
  departmentId        String?
  divisionId          String?
  districtId          String?
  branchId            String?

  accounts    Account[]
  sessions    Session[]
  sentMemos   Memo[]       @relation("SentMemos")
  receivedMemos User[]     @relation("ReceivedMemos")
  ccMemos     User[]       @relation("CcMemos")
  acknowledgedMemos User[] @relation("AcknowledgedMemos")
  archivedMemos User[]     @relation("ArchivedMemos")
  favoritedMemos User[]   @relation("FavoritedMemos")
  flaggedMemos User[]     @relation("FlaggedMemos")

  currentHolderOfMemos  Memo[]       @relation("CurrentHolder")
  previousHolderOfMemos Memo[]       @relation("PreviousHolders")
  activities            Activity[]
  role                  Role?        @relation(fields: [roleId], references: [id])
  office                Office?      @relation(fields: [officeId], references: [id])
  department            Department?  @relation(fields: [departmentId], references: [id])
  division              Division?    @relation(fields: [divisionId], references: [id])
  district              District?    @relation(fields: [districtId], references: [id])
  branch                Branch?      @relation(fields: [branchId], references: [id])
  
  delegations   Delegation[] @relation("Delegator")
  delegatedTo   Delegation[] @relation("Delegate")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String?
  users       User[]
}

model Office {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  type        String       @default("branch_office")
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  divisions Division[]
  users     User[]
  @@unique([name, officeId])
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
  @@unique([name, departmentId])
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  branches Branch[]
  users    User[]
  @@unique([name, officeId])
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  users      User[]
  @@unique([name, districtId])
}

model Label {
  id    String @id @default(cuid())
  name  String
  color String
  type  String @default("USER")
  memos Memo[]
}

model Memo {
  id                    String     @id @default(cuid())
  memo_reference_number String?
  subject               String
  body                  String     @db.Text
  status                String     @default("draft")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  scheduledFor          DateTime?
  fromId                String
  from                  User       @relation("SentMemos", fields: [fromId], references: [id], onDelete: Restrict)
  to                    User[]     @relation("ReceivedMemos")
  cc                    User[]     @relation("CcMemos")
  current_holderId      String?
  current_holder        User?      @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)
  previous_holders      User[]     @relation("PreviousHolders")
  acknowledgedBy        User[]     @relation("AcknowledgedMemos")
  archivedBy            User[]     @relation("ArchivedMemos")
  favoritedBy           User[]     @relation("FavoritedMemos")
  flaggedBy             User[]     @relation("FlaggedMemos")
  attachments           Attachment[]
  activity              Activity[]
  labels                Label[]
  replyToId             String?
  replyTo               Memo?      @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]     @relation("Replies")
  assignedFromId        String?
  assignedFrom          Memo?      @relation("Assignments", fields: [assignedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments           Memo[]     @relation("Assignments")

  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id              String   @id @default(cuid())
  from            String
  to              String
  cc              String?
  subject         String
  body            String   @db.Text
  status          String
  triggerEvent    String
  relatedEntityId String?
  messageId       String?
  errorMessage    String?
  createdAt       DateTime @default(now())
}

model Delegation {
  id          String   @id @default(cuid())
  delegatorId String
  delegator   User     @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegateId  String
  delegate    User     @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([delegatorId, delegateId])
}
