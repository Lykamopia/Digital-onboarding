// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  email               String?      @unique
  emailVerified       DateTime?
  image               String?
  hashedPassword      String?
  avatar              String?
  mustChangePassword  Boolean      @default(true)
  status              String       @default("active") // active, inactive, suspended
  accounts            Account[]
  sessions            Session[]
  memosFrom           Memo[]       @relation("MemosFrom")
  memosTo             Memo[]       @relation("MemosTo")
  memosCC             Memo[]       @relation("MemosCC")
  activities          Activity[]
  officeId            String?
  office              Office?      @relation(fields: [officeId], references: [id])
  roleId              String?
  role                Role?        @relation(fields: [roleId], references: [id])
  currentMemos        Memo[]       @relation("CurrentHolder")
  previousMemos       Memo[]       @relation("PreviousHolders")
  acknowledgedMemos   Memo[]       @relation("AcknowledgedBy")
  archivedMemos       Memo[]       @relation("ArchivedBy")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // comma-separated list of permissions
  users       User[]
}

model Division {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
}

model Department {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  officeId    String?
  office      Office?     @relation(fields: [officeId], references: [id])
  divisions   Division[]
}

model Branch {
    id          String      @id @default(cuid())
    name        String
    code        String      @unique
    districtId  String?
    district    District?   @relation(fields: [districtId], references: [id])
}

model District {
    id          String      @id @default(cuid())
    name        String
    code        String      @unique
    officeId    String?
    office      Office?     @relation(fields: [officeId], references: [id])
    branches    Branch[]
}

model Office {
    id            String    @id @default(cuid())
    name          String
    code          String    @unique
    type          String // "division" or "branch"
    users         User[]
    departments   Department[]
    districts     District[]
}


model Memo {
  id                      String       @id @default(cuid())
  memo_reference_number   String?      @unique
  subject                 String
  body                    String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  status                  String       @default("draft") // draft, sent, read, acknowledged
  fromId                  String
  from                    User         @relation("MemosFrom", fields: [fromId], references: [id])
  to                      User[]       @relation("MemosTo")
  cc                      User[]       @relation("MemosCC")
  current_holderId        String?
  current_holder          User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders        User[]       @relation("PreviousHolders")
  attachments             Attachment[]
  activity                Activity[]
  replies                 Memo[]       @relation("Replies")      
  replyToId               String?
  replyTo                 Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  acknowledgedBy          User[]       @relation("AcknowledgedBy")
  archivedBy              User[]       @relation("ArchivedBy")
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g., sent, viewed, acknowledged, commented, forwarded
  details   String?
  timestamp DateTime @default(now())
}