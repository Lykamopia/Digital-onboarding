// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memo {
  id                      String       @id @default(uuid())
  memo_reference_number   String?
  fromId                  String
  from                    User         @relation("MemosSent", fields: [fromId], references: [id])
  to                      User[]       @relation("MemosReceived")
  cc                      User[]       @relation("MemosCc")
  subject                 String
  body                    String       @db.Text
  attachments             Attachment[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  status                  String       @default("draft") // "draft", "sent", "scheduled"
  current_holderId        String?
  current_holder          User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders        User[]       @relation("PreviousHolders")
  acknowledgedBy          User[]       @relation("MemosAcknowledged")
  activity                Activity[]
  replies                 Memo[]       @relation("Replies")
  replyToId               String?
  replyTo                 Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduledFor            DateTime?
  archivedBy              User[]       @relation("ArchivedMemos")
  favoritedBy             User[]       @relation("FavoriteMemos")
  labels                  Label[]      @relation("MemoLabels")
}

model Attachment {
  id     String @id @default(uuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(uuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())
}

model Label {
  id    String @id @default(uuid())
  name  String @unique
  color String
  type  String // "SYSTEM" or "USER"
  memos Memo[] @relation("MemoLabels")
}

// ORGANIZATIONAL STRUCTURE
model Office {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  type        String // "division_office", "branch_office", "head_office", "division", "branch"
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
}

model Division {
  id           String     @id @default(uuid())
  name         String     @unique
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  code     String   @unique
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

// USER AND ROLES
model User {
  id                      String       @id @default(uuid())
  name                    String
  email                   String       @unique
  avatar                  String?
  hashedPassword          String?
  mustChangePassword      Boolean      @default(true)
  status                  String       @default("active") // "active", "inactive"
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  roleId                  String
  role                    Role         @relation(fields: [roleId], references: [id])
  officeId                String
  office                  Office       @relation(fields: [officeId], references: [id])
  sentMemos               Memo[]       @relation("MemosSent")
  receivedMemos           Memo[]       @relation("MemosReceived")
  ccMemos                 Memo[]       @relation("MemosCc")
  memosAsCurrentHolder    Memo[]       @relation("CurrentHolder")
  acknowledgedMemos       Memo[]       @relation("MemosAcknowledged")
  archivedMemos           Memo[]       @relation("ArchivedMemos")
  favoriteMemos           Memo[]       @relation("FavoriteMemos")
  heldMemos               Memo[]       @relation("PreviousHolders")
  activities              Activity[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String
  users       User[]
}
