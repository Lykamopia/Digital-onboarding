// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  email               String?      @unique
  emailVerified       DateTime?
  avatar              String?
  hashedPassword      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  status              String       @default("active") // active, inactive
  roleId              String?
  officeId            String?
  departmentId        String?
  divisionId          String?
  districtId          String?
  branchId            String?
  mustChangePassword  Boolean      @default(false)
  signature           String?
  failedLoginAttempts Int          @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int          @default(0)

  role          Role?        @relation(fields: [roleId], references: [id])
  office        Office?      @relation(fields: [officeId], references: [id])
  department    Department?  @relation(fields: [departmentId], references: [id])
  division      Division?    @relation(fields: [divisionId], references: [id])
  district      District?    @relation(fields: [districtId], references: [id])
  branch        Branch?      @relation(fields: [branchId], references: [id])
  
  sentMemos      Memo[]       @relation("SentMemos")
  currentMemo    Memo[]       @relation("CurrentHolder")
  previousMemos  Memo[]       @relation("PreviousHolders")
  
  toMemos        Memo[]       @relation("ToRecipients")
  ccMemos        Memo[]       @relation("CcRecipients")
  
  activities     Activity[]
  
  acknowledgedMemos Memo[]     @relation("AcknowledgedBy")
  archivedMemos     Memo[]     @relation("ArchivedBy")
  favoritedMemos    Memo[]     @relation("FavoritedBy")
  flaggedMemos      Memo[]     @relation("FlaggedBy")
}

model Memo {
  id                      String   @id @default(cuid())
  memo_reference_number   String?
  subject                 String
  body                    String   @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  status                  String   // e.g., "draft", "sent", "scheduled", "archived"
  scheduledFor            DateTime?
  
  fromId                  String
  current_holderId        String?
  
  replyToId               String?
  forwardFromId           String?
  
  from              User        @relation("SentMemos", fields: [fromId], references: [id], onDelete: Cascade)
  current_holder    User?       @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders  User[]      @relation("PreviousHolders")
  to                User[]      @relation("ToRecipients")
  cc                User[]      @relation("CcRecipients")

  attachments     Attachment[]
  activity        Activity[]
  
  acknowledgedBy  User[]      @relation("AcknowledgedBy")
  archivedBy      User[]      @relation("ArchivedBy")
  favoritedBy     User[]      @relation("FavoritedBy")
  flaggedBy       User[]      @relation("FlaggedBy")
  
  labels          Label[]

  replies         Memo[]      @relation("Replies")
  replyTo         Memo?       @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model Attachment {
  id      String @id @default(cuid())
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  name    String
  type    String
  size    Int
  url     String
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String
  users       User[]
}

model Office {
    id          String   @id @default(cuid())
    name        String   @unique
    code        String   @unique
    type        String   @default("branch_office") // head_office, division_office, branch_office
    departments Department[]
    districts   District[]
    users       User[]
}

model Department {
    id          String   @id @default(cuid())
    name        String
    code        String
    officeId    String
    office      Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
    divisions   Division[]
    users       User[]
}

model District {
    id          String   @id @default(cuid())
    name        String
    code        String
    officeId    String
    office      Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
    branches    Branch[]
    users       User[]
}

model Division {
    id              String      @id @default(cuid())
    name            String
    code            String
    departmentId    String
    department      Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
    users           User[]
}

model Branch {
    id          String      @id @default(cuid())
    name        String
    code        String
    districtId  String
    district    District    @relation(fields: [districtId], references: [id], onDelete: Cascade)
    users       User[]
}

model Label {
    id      String  @id @default(cuid())
    name    String  @unique
    color   String
    memos   Memo[]
    type    String  @default("USER") // SYSTEM or USER
}
