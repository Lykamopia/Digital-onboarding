// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  hashedPassword     String?
  avatar             String?
  image              String? // from next-auth
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  mustChangePassword Boolean   @default(false)
  status             String    @default("active") // active, inactive

  accounts Account[]
  sessions Session[]

  sentMemos           Memo[]          @relation("SentMemos")
  receivedMemosTo     Memo[]          @relation("ReceivedMemosTo")
  receivedMemosCc     Memo[]          @relation("ReceivedMemosCc")
  memosHeld           Memo[]          @relation("CurrentHolder")
  previousMemosHeld   Memo[]          @relation("PreviousHolder")
  acknowledgedMemos   Memo[]          @relation("AcknowledgedBy")
  archivedMemos       Memo[]          @relation("ArchivedBy")
  activities          Activity[]

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ORGANIZATIONAL STRUCTURE

model Division {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  departments  Department[]
}

model Department {
  id         String     @id @default(cuid())
  name       String
  code       String
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id])
  offices    Office[]

  @@unique([name, divisionId])
  @@unique([code, divisionId])
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]

  @@unique([name, departmentId])
  @@unique([code, departmentId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String // Comma-separated list of permissions
  users       User[]
}

// MEMO SYSTEM

model Memo {
  id                    String        @id @default(cuid())
  memo_reference_number String        @unique
  subject               String
  body                  String
  status                String // e.g., "draft", "sent", "read", "acknowledged"
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  fromId                String
  from                  User          @relation("SentMemos", fields: [fromId], references: [id])
  
  to                    User[]        @relation("ReceivedMemosTo")
  cc                    User[]        @relation("ReceivedMemosCc")
  
  current_holderId      String?
  current_holder        User?         @relation("CurrentHolder", fields: [current_holderId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  previous_holders      User[]        @relation("PreviousHolder")
  acknowledgedBy        User[]        @relation("AcknowledgedBy")
  archivedBy            User[]        @relation("ArchivedBy")

  attachments           Attachment[]
  activity              Activity[]
  
  // For threaded replies
  replies               Memo[]        @relation("Replies")
  replyToId             String?
  replyTo               Memo?         @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // This helps Prisma understand the many-to-many relationship
  archivedById          String[]
}

model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g., "sent", "viewed", "commented", "forwarded", "acknowledged"
  details   String?
  timestamp DateTime @default(now())
}
