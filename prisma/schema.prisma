// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  signature          String?
  hashedPassword     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  status             String    @default("active") // active, inactive
  mustChangePassword Boolean   @default(true)

  // Role
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Org Structure
  officeId     String
  departmentId String?
  divisionId   String?
  districtId   String?
  branchId     String?

  office     Office     @relation(fields: [officeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  division   Division?   @relation(fields: [divisionId], references: [id])
  district   District?  @relation(fields: [districtId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  // Memo Relations
  memosFrom           Memo[]         @relation("MemosFrom")
  memosTo             Memo[]         @relation("MemosTo")
  memosCc             Memo[]         @relation("MemosCc")
  memosPreviouslyHeld Memo[]         @relation("MemosPreviouslyHeld")
  memosAcknowledged   Memo[]         @relation("MemosAcknowledged")
  memosArchived       Memo[]         @relation("MemosArchived")
  memosFavorited      Memo[]         @relation("MemosFavorited")
  memosFlagged        Memo[]         @relation("MemosFlagged")
  currentMemos        Memo[]         @relation("CurrentHolder")
  activities          Activity[]
}

model Memo {
  id                    String   @id @default(cuid())
  memo_reference_number String?  @unique
  subject               String
  body                  String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  status                String // "draft", "sent", "scheduled"

  // Relations
  fromId           String
  current_holderId String?
  from             User     @relation("MemosFrom", fields: [fromId], references: [id])
  to               User[]   @relation("MemosTo")
  cc               User[]   @relation("MemosCc")
  current_holder   User?    @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders User[]   @relation("MemosPreviouslyHeld")

  attachments    Attachment[]
  activity       Activity[]
  acknowledgedBy User[]       @relation("MemosAcknowledged")
  archivedBy     User[]       @relation("MemosArchived")
  favoritedBy    User[]       @relation("MemosFavorited")
  flaggedBy      User[]       @relation("MemosFlagged")

  labels Label[]

  // For replies
  replyToId String?
  replyTo   Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Memo[]  @relation("Replies")

  // For forwarding
  forwardFromId String?
  forwardFrom   Memo?   @relation("Forwards", fields: [forwardFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forwards      Memo[]  @relation("Forwards")

  // Scheduled memos
  scheduledFor DateTime?
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  actorId   String
  memoId    String
  action    String
  details   String?
  timestamp DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Label {
  id      String   @id @default(cuid())
  name    String   @unique
  color   String
  type    String   @default("USER") // SYSTEM or USER
  memos   Memo[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Office {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  type        String // e.g. 'division_office', 'branch_office'
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id        String    @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office    @relation(fields: [officeId], references: [id])
  divisions Division[]
  users     User[]
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]
  users    User[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
}