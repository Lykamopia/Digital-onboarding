
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  avatar             String?
  mustChangePassword Boolean   @default(true)
  status             String    @default("active")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  memosFrom    Memo[]    @relation("MemoFrom")
  memosTo      Memo[]    @relation("MemoTo")
  memosCC      Memo[]    @relation("MemoCC")
  activity     Activity[]
  officeId     String
  office       Office    @relation(fields: [officeId], references: [id])
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])

  memosAcknowledged Memo[] @relation("AcknowledgedBy")
  memosArchived     Memo[] @relation("ArchivedBy")
  currentMemosHeld  Memo[] @relation("CurrentHolder")
  previousMemosHeld Memo[] @relation("PreviousHolders")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Division {
  id         String       @id @default(cuid())
  name       String
  code       String
  departments Department[]
}

model Department {
  id         String   @id @default(cuid())
  name       String
  code       String
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])
  offices    Office[]
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  code      String
  districts District[]
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id])
  offices  Office[]
}

model Office {
  id           String    @id @default(cuid())
  name         String
  code         String
  type         String // 'division' or 'branch'
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  districtId   String?
  district     District?   @relation(fields: [districtId], references: [id])
  users        User[]
}

model Memo {
  id                      String   @id @default(cuid())
  memo_reference_number   String?  @unique
  subject                 String
  body                    String   @db.Text
  status                  String   @default("draft")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  fromId                  String
  from                    User     @relation("MemoFrom", fields: [fromId], references: [id])
  to                      User[]   @relation("MemoTo")
  cc                      User[]   @relation("MemoCC")
  
  attachments             Attachment[]
  activity                Activity[]
  
  current_holderId        String?
  current_holder          User?    @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders        User[]   @relation("PreviousHolders")

  acknowledgedBy          User[]   @relation("AcknowledgedBy")
  archivedBy              User[]   @relation("ArchivedBy")

  replyToId               String?
  replyTo                 Memo?    @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies                 Memo[]   @relation("Replies")
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String @db.Text
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
}
