
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  signature          String?
  hashedPassword     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  status             String    @default("active")
  mustChangePassword Boolean   @default(false)

  sentMemos          Memo[]    @relation("SentMemos")
  receivedMemos      Memo[]    @relation("ReceivedMemos")
  ccMemos            Memo[]    @relation("CcMemos")
  currentMemos       Memo[]    @relation("CurrentHolder")
  memosPreviouslyHeld Memo[] @relation("PreviousHolders")
  memosAcknowledged  Memo[]    @relation("AcknowledgedBy")
  memosArchived      Memo[]    @relation("ArchivedBy")
  memosFavorited     Memo[]    @relation("FavoritedBy")
  memosFlagged       Memo[]    @relation("FlaggedBy")
  activities         Activity[]

  roleId             String?
  role               Role?     @relation(fields: [roleId], references: [id])
  
  officeId           String?
  office             Office?   @relation(fields: [officeId], references: [id])
  
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])

  divisionId         String?
  division           Division? @relation(fields: [divisionId], references: [id])

  districtId         String?
  district           District? @relation(fields: [districtId], references: [id])

  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
}

model Memo {
  id                   String     @id @default(cuid())
  memo_reference_number String?
  subject              String
  body                 String     @db.Text
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  status               String
  fromId               String
  current_holderId     String?
  scheduledFor         DateTime?

  from                 User       @relation("SentMemos", fields: [fromId], references: [id])
  to                   User[]     @relation("ReceivedMemos")
  cc                   User[]     @relation("CcMemos")
  current_holder       User?      @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders     User[]     @relation("PreviousHolders")
  attachments          Attachment[]
  activity             Activity[]
  acknowledgedBy       User[]     @relation("AcknowledgedBy")
  archivedBy           User[]     @relation("ArchivedBy")
  favoritedBy          User[]     @relation("FavoritedBy")
  flaggedBy            User[]     @relation("FlaggedBy")

  labels               Label[]

  replyToId            String?
  replyTo              Memo?      @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies              Memo[]     @relation("Replies")

  forwardFromId        String?
  forwardFrom          Memo?      @relation("Forwards", fields: [forwardFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forwards             Memo[]     @relation("Forwards")
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int
  url       String
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String
  type  String @default("USER") // SYSTEM or USER
  memos Memo[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Office {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String
  type        String // 'division_office' or 'branch_office'
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
  users     User[]
}

model Division {
  id           String  @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model District {
    id       String   @id @default(cuid())
    name     String
    code     String
    officeId String
    office   Office   @relation(fields: [officeId], references: [id])
    branches Branch[]
    users    User[]
}

model Branch {
    id         String   @id @default(cuid())
    name       String
    code       String
    districtId String
    district   District @relation(fields: [districtId], references: [id])
    users      User[]
}
