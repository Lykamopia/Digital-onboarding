
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String?   @unique
  emailVerified           DateTime?
  image                   String?
  hashedPassword          String?
  avatar                  String?
  status                  String    @default("active")
  mustChangePassword      Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  
  sentMemos             Memo[]          @relation("SentMemos")
  receivedMemos         Memo[]          @relation("ReceivedMemos")
  ccMemos               Memo[]          @relation("CCMemos")
  
  currentMemos          Memo[]          @relation("CurrentHolder")
  previouslyHeldMemos   Memo[]          @relation("PreviousHolder")
  
  acknowledgedMemos     Memo[]          @relation("AcknowledgedMemos")
  archivedMemos         Memo[]          @relation("ArchivedMemos")

  activities            Activity[]

  officeId              String
  office                Office         @relation(fields: [officeId], references: [id])
  
  roleId                String
  role                  Role           @relation(fields: [roleId], references: [id])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String   // Comma-separated list of permissions
  users       User[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Division {
    id            String       @id @default(cuid())
    name          String       @unique
    code          String       @unique
    departments   Department[]
}

model Department {
    id          String    @id @default(cuid())
    name        String
    code        String
    divisionId  String
    division    Division  @relation(fields: [divisionId], references: [id])
    offices     Office[]
}

model Office {
    id            String     @id @default(cuid())
    name          String
    code          String
    departmentId  String
    department    Department @relation(fields: [departmentId], references: [id])
    users         User[]
}

model Memo {
  id                    String      @id @default(cuid())
  memo_reference_number String      @unique
  subject               String
  body                  String      @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  status                String      // e.g., 'draft', 'sent', 'read', 'acknowledged'

  fromId                String
  from                  User        @relation("SentMemos", fields: [fromId], references: [id])
  
  to                    User[]      @relation("ReceivedMemos")
  cc                    User[]      @relation("CCMemos")
  
  current_holderId      String?
  current_holder        User?       @relation("CurrentHolder", fields: [current_holderId], references: [id])

  previous_holders      User[]      @relation("PreviousHolder")
  
  acknowledgedBy        User[]      @relation("AcknowledgedMemos")
  archivedBy            User[]      @relation("ArchivedMemos")
  archivedById          String[]

  // Self-referencing relation for replies
  replyToId             String?
  replyTo               Memo?         @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies               Memo[]        @relation("Replies")

  attachments           Attachment[]
  activity              Activity[]
}

model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String @db.Text
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String   // e.g., 'sent', 'viewed', 'acknowledged', 'commented', 'forwarded'
  details   String?
  timestamp DateTime @default(now())
}
