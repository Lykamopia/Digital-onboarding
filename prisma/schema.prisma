
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  hashedPassword     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  accounts           Account[]
  sessions           Session[]
  memosFrom          Memo[]    @relation("MemosFrom")
  memosTo            Memo[]    @relation("MemosTo")
  memosCc            Memo[]    @relation("MemosCc")
  memosAcknowledged  Memo[]    @relation("MemosAcknowledged")
  memosArchived      Memo[]    @relation("MemosArchived")
  currentMemos       Memo[]    @relation("CurrentHolder")
  previousMemos      Memo[]    @relation("PreviousHolders")
  activities         Activity[]
  mustChangePassword Boolean   @default(false)
  status             String    @default("active") // active, inactive

  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])

  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])

  @@index([roleId])
  @@index([branchId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Memo {
  id                      String      @id @default(cuid())
  memo_reference_number   String?     @unique
  subject                 String
  body                    String
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  status                  String
  fromId                  String
  from                    User        @relation("MemosFrom", fields: [fromId], references: [id])
  to                      User[]      @relation("MemosTo")
  cc                      User[]      @relation("MemosCc")
  current_holderId        String?
  current_holder          User?       @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders        User[]      @relation("PreviousHolders")
  acknowledgedBy          User[]      @relation("MemosAcknowledged")
  archivedBy              User[]      @relation("MemosArchived")
  attachments             Attachment[]
  activity                Activity[]
  replies                 Memo[]      @relation("Replies")
  replyTo                 Memo?       @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId               String?

  @@index([fromId])
  @@index([current_holderId])
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])

  @@index([memoId])
}

model Activity {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g., 'sent', 'viewed', 'acknowledged', 'commented', 'forwarded'
  details   String?
  timestamp DateTime @default(now())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])

  @@index([memoId])
  @@index([actorId])
}

model Office {
  id           String        @id @default(cuid())
  name         String
  code         String        @unique
  departments  Department[]
  districts    District[]
}

model Department {
  id         String     @id @default(cuid())
  name       String
  code       String     @unique
  officeId   String
  office     Office     @relation(fields: [officeId], references: [id])
  divisions  Division[]

  @@index([officeId])
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String   @unique
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]

  @@index([officeId])
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]

  @@index([districtId])
}
