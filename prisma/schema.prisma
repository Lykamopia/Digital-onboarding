// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Division {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  departments Department[]
}

model Department {
  id         String     @id @default(cuid())
  name       String
  code       String
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id])
  offices    Office[]
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model User {
  id                 String       @id @default(cuid())
  name               String?
  email              String?      @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  avatar             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  status             String       @default("active")
  mustChangePassword Boolean      @default(false)
  officeId           String
  roleId             String
  accounts           Account[]
  sessions           Session[]
  role               Role         @relation(fields: [roleId], references: [id])
  office             Office       @relation(fields: [officeId], references: [id])
  sentMemos          Memo[]       @relation("SentMemos")
  memosTo            Memo[]       @relation("MemosTo")
  memosCc            Memo[]       @relation("MemosCc")
  activity           Activity[]
  memosHolding       Memo[]       @relation("CurrentHolder")
  memosPreviouslyHeld Memo[]       @relation("PreviousHolder")
  acknowledgedMemos   Memo[]       @relation("AcknowledgedBy")
  archivedMemos       Memo[]       @relation("ArchivedBy")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String       @unique
  subject               String
  body                  String
  status                String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  fromId                String
  from                  User         @relation("SentMemos", fields: [fromId], references: [id])
  to                    User[]       @relation("MemosTo")
  cc                    User[]       @relation("MemosCc")
  attachments           Attachment[]
  activity              Activity[]
  
  current_holderId      String?
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders      User[]       @relation("PreviousHolder")
  
  acknowledgedBy        User[]       @relation("AcknowledgedBy")
  archivedBy            User[]       @relation("ArchivedBy")

  replyToId             String?
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id])
  replies               Memo[]       @relation("Replies")

  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
}

model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}