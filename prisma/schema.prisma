
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Memo {
  id                      String      @id @default(cuid())
  memo_reference_number   String?     @unique
  subject                 String
  body                    String      @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  status                  String      @default("draft")
  isFlagged               Boolean     @default(false)
  fromId                  String
  from                    User        @relation("MemosSent", fields: [fromId], references: [id])
  to                      User[]      @relation("MemosReceived")
  cc                      User[]      @relation("MemosCc")
  attachments             Attachment[]
  activity                Activity[]
  current_holderId        String?
  current_holder          User?       @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)
  previous_holders        User[]      @relation("PreviousHolders")
  acknowledgedBy          User[]      @relation("AcknowledgedMemos")
  archivedBy              User[]      @relation("ArchivedMemos")
  favoritedBy             User[]      @relation("FavoritedMemos")

  labels                  Label[]     @relation("MemoLabels")

  replies                 Memo[]      @relation("Replies")
  replyTo                 Memo?       @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId               String?

  scheduledFor            DateTime?
}

model Attachment {
  id      String    @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String
  memoId  String
  memo    Memo      @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation("UserActivities", fields: [actorId], references: [id])
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String
  type  String @default("USER") // SYSTEM or USER
  memos Memo[] @relation("MemoLabels")
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String?   @unique
  emailVerified           DateTime?
  image                   String?
  avatar                  String?
  hashedPassword          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  status                  String    @default("active")
  mustChangePassword      Boolean   @default(false)

  sentMemos               Memo[]    @relation("MemosSent")
  receivedMemos           Memo[]    @relation("MemosReceived")
  ccMemos                 Memo[]    @relation("MemosCc")
  memosAsCurrentHolder    Memo[]    @relation("CurrentHolder")
  memosAsPreviousHolder   Memo[]    @relation("PreviousHolders")
  acknowledgedMemos       Memo[]    @relation("AcknowledgedMemos")
  archivedMemos           Memo[]    @relation("ArchivedMemos")
  favoritedMemos          User[]    @relation("FavoritedMemos")
  
  activities              Activity[] @relation("UserActivities")

  officeId                String?
  office                  Office?    @relation(fields: [officeId], references: [id])
  
  roleId                  String?
  role                    Role?      @relation(fields: [roleId], references: [id])

  accounts Account[]
  sessions Session[]
}

model Office {
    id          String @id @default(cuid())
    name        String
    code        String
    type        String // head_office, division_office, branch_office, division, branch
    
    departments Department[]
    districts   District[]
    users       User[]
}

model Department {
    id        String @id @default(cuid())
    name      String
    code      String
    officeId  String
    office    Office @relation(fields: [officeId], references: [id])
    divisions Division[]
}

model Division {
    id            String @id @default(cuid())
    name          String
    code          String
    departmentId  String
    department    Department @relation(fields: [departmentId], references: [id])
}

model District {
    id        String @id @default(cuid())
    name      String
    code      String
    officeId  String
    office    Office @relation(fields: [officeId], references: [id])
    branches  Branch[]
}

model Branch {
    id          String @id @default(cuid())
    name        String
    code        String
    districtId  String
    district    District @relation(fields: [districtId], references: [id])
}


model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String
  users       User[]
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
