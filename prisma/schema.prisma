// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Memo {
  id                      String   @id @default(cuid())
  memo_reference_number   String?  @unique
  subject                 String
  body                    String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  status                  String   @default("draft") // "draft", "sent", "scheduled", "archived"
  fromId                  String
  current_holderId        String?

  from           User     @relation("MemosFrom", fields: [fromId], references: [id], onDelete: Cascade)
  current_holder User?    @relation("MemosHeld", fields: [current_holderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to             User[]   @relation("MemosTo")
  cc             User[]   @relation("MemosCC")

  attachments      Attachment[]
  activity         Activity[]
  previous_holders User[]       @relation("MemosPreviouslyHeld")
  acknowledgedBy   User[]       @relation("MemosAcknowledged")
  archivedBy       User[]       @relation("MemosArchived")
  favoritedBy      User[]       @relation("MemosFavorited")
  flaggedBy        User[]       @relation("MemosFlagged")
  labels           Label[]      @relation("MemoLabels")

  // For replies
  replyToId String?
  replyTo   Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Memo[]  @relation("Replies")

  // For scheduled memos
  scheduledFor DateTime?
}

model User {
  id               String  @id @default(cuid())
  name             String
  email            String  @unique
  hashedPassword   String?
  avatar           String?
  signature        String?
  status           String  @default("active") // "active", "inactive"
  mustChangePassword Boolean @default(false)

  officeId         String?
  departmentId     String?
  divisionId       String?
  districtId       String?
  branchId         String?
  roleId           String

  office           Office?     @relation(fields: [officeId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  division         Division?   @relation(fields: [divisionId], references: [id])
  district         District?   @relation(fields: [districtId], references: [id])
  branch           Branch?     @relation(fields: [branchId], references: [id])
  role             Role        @relation(fields: [roleId], references: [id])

  memosFrom          Memo[] @relation("MemosFrom")
  memosTo            Memo[] @relation("MemosTo")
  memosCC            Memo[] @relation("MemosCC")
  memosHeld          Memo[] @relation("MemosHeld")
  memosPreviouslyHeld Memo[] @relation("MemosPreviouslyHeld")
  memosAcknowledged  Memo[] @relation("MemosAcknowledged")
  memosArchived      Memo[] @relation("MemosArchived")
  memosFavorited     Memo[] @relation("MemosFavorited")
  memosFlagged       Memo[] @relation("MemosFlagged")

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  permissions String  // Comma-separated list of permissions
  users       User[]
}

model Office {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  type        String       // division_office, branch_office, head_office
  users       User[]
  departments Department[]
  districts   District[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
  users     User[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]
  users    User[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
}

model Label {
    id    String @id @default(cuid())
    name  String
    color String
    type  String @default("USER") // SYSTEM, USER
    memos Memo[] @relation("MemoLabels")
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  actorId   String
  action    String // e.g., 'created', 'sent', 'viewed', 'commented', 'forwarded', 'acknowledged', 'archived'
  details   String?
  timestamp DateTime @default(now())

  memo  Memo @relation(fields: [memoId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
}
