
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memo {
  id                    String        @id @default(cuid())
  memo_reference_number String?       @unique
  subject               String
  body                  String        @db.Text
  status                String        @default("draft") // draft, sent, archived
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  fromId                String
  from                  User          @relation("MemosFrom", fields: [fromId], references: [id])
  to                    User[]        @relation("MemosTo")
  cc                    User[]        @relation("MemosCc")
  current_holderId      String?
  current_holder        User?         @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders      User[]        @relation("PreviousHolders")
  attachments           Attachment[]
  activity              Activity[]
  acknowledgedBy        User[]        @relation("AcknowledgedMemos")
  archivedBy            User[]        @relation("ArchivedMemos")
  favoritedBy           User[]        @relation("FavoritedMemos")
  flaggedBy             User[]        @relation("FlaggedMemos")

  replies   Memo[] @relation("MemoReplies")
  replyTo   Memo?  @relation("MemoReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId String?

  forwardFromId String?
  scheduledFor  DateTime?
  labels        Label[]

  @@index([fromId])
  @@index([current_holderId])
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g., 'sent', 'viewed', 'acknowledged', 'commented', 'forwarded'
  details   String?  @db.Text
  timestamp DateTime @default(now())

  @@index([memoId])
  @@index([actorId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  avatar        String?
  signature     String?   @db.Text
  hashedPassword String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  status        String    @default("active") // active, inactive
  mustChangePassword Boolean @default(true)
  failedLoginAttempts Int    @default(0)
  lockoutUntil        DateTime?

  // Relationships
  sentMemos           Memo[]      @relation("MemosFrom")
  receivedMemos       Memo[]      @relation("MemosTo")
  ccMemos             Memo[]      @relation("MemosCc")
  heldMemos           Memo[]      @relation("CurrentHolder")
  previouslyHeldMemos Memo[]      @relation("PreviousHolders")
  acknowledgedMemos   Memo[]      @relation("AcknowledgedMemos")
  archivedMemos       Memo[]      @relation("ArchivedMemos")
  favoritedMemos      Memo[]      @relation("FavoritedMemos")
  flaggedMemos        Memo[]      @relation("FlaggedMemos")

  activities          Activity[]

  roleId   String?
  role     Role?     @relation(fields: [roleId], references: [id])
  
  officeId      String?
  office        Office?   @relation(fields: [officeId], references: [id])

  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  
  divisionId    String?
  division      Division?   @relation(fields: [divisionId], references: [id])

  districtId    String?
  district      District?   @relation(fields: [districtId], references: [id])
  
  branchId      String?
  branch        Branch?     @relation(fields: [branchId], references: [id])

  accounts Account[]

  @@index([roleId])
  @@index([officeId])
  @@index([departmentId])
  @@index([divisionId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String @db.Text // Comma-separated list of permissions
  users       User[]
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String
  type  String @default("USER") // SYSTEM or USER
  memos Memo[]
}

// Organizational Structure
model Office {
    id          String   @id @default(cuid())
    name        String   @unique
    code        String   @unique
    type        String   // e.g. division_office, branch_office
    users       User[]
    departments Department[]
    districts   District[]
}

model Department {
    id        String   @id @default(cuid())
    name      String
    code      String
    officeId  String
    office    Office   @relation(fields: [officeId], references: [id])
    users     User[]
    divisions Division[]
    @@unique([name, officeId])
    @@index([officeId])
}

model Division {
    id           String   @id @default(cuid())
    name         String
    code         String
    departmentId String
    department   Department @relation(fields: [departmentId], references: [id])
    users        User[]
    @@unique([name, departmentId])
    @@index([departmentId])
}

model District {
    id       String   @id @default(cuid())
    name     String
    code     String
    officeId String
    office   Office   @relation(fields: [officeId], references: [id])
    users    User[]
    branches Branch[]
    @@unique([name, officeId])
    @@index([officeId])
}

model Branch {
    id         String   @id @default(cuid())
    name       String
    code       String
    districtId String
    district   District @relation(fields: [districtId], references: [id])
    users      User[]
    @@unique([name, districtId])
    @@index([districtId])
}


// Models for NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
