// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  email               String?      @unique
  emailVerified       DateTime?
  image               String?
  avatar              String?
  hashedPassword      String?
  roleId              String?
  status              String       @default("active")
  mustChangePassword  Boolean      @default(true)
  failedLoginAttempts Int          @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int          @default(0)
  signature           String?
  onboardingCompleted Boolean      @default(false)
  officeId            String?
  departmentId        String?
  divisionId          String?
  districtId          String?
  branchId            String?

  accounts    Account[]
  sessions    Session[]
  sentMemos   Memo[]       @relation("SentMemos")
  
  // Many-to-many relations with Memo
  receivedMemos       Memo[] @relation("ReceivedMemos")
  ccMemos             Memo[] @relation("CcMemos")
  acknowledgedMemos   Memo[] @relation("AcknowledgedMemos")
  archivedMemos       Memo[] @relation("ArchivedMemos")
  favoritedMemos      Memo[] @relation("FavoritedMemos")
  flaggedMemos        Memo[] @relation("FlaggedMemos")
  previousHolderOfMemos Memo[] @relation("PreviousHolders")

  // One-to-many relations
  currentHolderOfMemos  Memo[]       @relation("CurrentHolder")
  activities            Activity[]
  
  // Relations to organizational structure
  role                  Role?        @relation(fields: [roleId], references: [id])
  office                Office?      @relation(fields: [officeId], references: [id])
  department            Department?  @relation(fields: [departmentId], references: [id])
  division              Division?    @relation(fields: [divisionId], references: [id])
  district              District?    @relation(fields: [districtId], references: [id])
  branch                Branch?      @relation(fields: [branchId], references: [id])

  // Delegation relations
  delegations   Delegation[] @relation("Delegator")
  delegatedTo   Delegation[] @relation("Delegate")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  permissions String
  users       User[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
  users     User[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String   @unique
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]
  users    User[]
}

model Office {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  type        String       @default("branch_office") // branch_office, division_office, head_office
  departments Department[]
  districts   District[]
  users       User[]
}

model Label {
  id    String @id @default(cuid())
  name  String
  color String
  type  String @default("USER") // USER or SYSTEM
  memos Memo[]
}

model Memo {
  id                    String     @id @default(cuid())
  memo_reference_number String?
  subject               String
  body                  String     @db.Text
  status                String     @default("draft")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  scheduledFor          DateTime?
  fromId                String
  from                  User       @relation("SentMemos", fields: [fromId], references: [id], onDelete: Restrict)
  
  to                    User[]     @relation("ReceivedMemos")
  cc                    User[]     @relation("CcMemos")
  
  current_holderId      String?
  current_holder        User?      @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)
  previous_holders      User[]     @relation("PreviousHolders")

  acknowledgedBy        User[]     @relation("AcknowledgedMemos")
  archivedBy            User[]     @relation("ArchivedMemos")
  favoritedBy           User[]     @relation("FavoritedMemos")
  flaggedBy             User[]     @relation("FlaggedMemos")
  
  attachments           Attachment[]
  activity              Activity[]
  labels                Label[]
  
  replyToId             String?
  replyTo               Memo?      @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]     @relation("Replies")
  
  assignedFromId        String?
  assignedFrom          Memo?      @relation("Assignments", fields: [assignedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments           Memo[]     @relation("Assignments")

  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
  @@index([assignedFromId])
}

model Attachment {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())

  @@index([memoId])
}

model Activity {
  id          String   @id @default(cuid())
  memoId      String
  memo        Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action      String
  details     String?  @db.Text
  timestamp   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([memoId])
  @@index([actorId])
}

model Setting {
  key   String @id
  value Json
}

model EmailLog {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  from              String
  to                String
  cc                String?
  subject           String
  body              String   @db.Text
  status            String   // "sent", "failed"
  triggerEvent      String   // e.g., "new_memo", "password_reset"
  relatedEntityId   String?
  messageId         String?
  errorMessage      String?

  @@index([to])
  @@index([status])
  @@index([triggerEvent])
}

model Delegation {
  id           String   @id @default(cuid())
  delegatorId  String
  delegateId   String
  permissions  String   // Comma-separated list of permissions
  createdAt    DateTime @default(now())
  
  delegator    User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegate     User     @relation("Delegate", fields: [delegateId], references: [id])
  
  @@unique([delegatorId, delegateId])
  @@index([delegatorId])
  @@index([delegateId])
}
