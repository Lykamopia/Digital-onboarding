// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ORGANIZATIONAL STRUCTURE
model Office {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  type        String    @default("branch_office") // branch_office, division_office, head_office
  
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    
  
  officeId    String
  office      Office    @relation(fields: [officeId], references: [id])
  
  divisions   Division[]
  users       User[]

  @@unique([officeId, code])
}

model Division {
  id            String    @id @default(cuid())
  name          String
  code          String

  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])

  users         User[]
  
  @@unique([departmentId, name])
  @@unique([departmentId, code])
}

model District {
    id          String    @id @default(cuid())
    name        String
    code        String

    officeId    String
    office      Office    @relation(fields: [officeId], references: [id])

    branches    Branch[]
    users       User[]

    @@unique([officeId, name])
    @@unique([officeId, code])
}

model Branch {
    id          String    @id @default(cuid())
    name        String
    code        String
    
    districtId  String
    district    District  @relation(fields: [districtId], references: [id])

    users       User[]

    @@unique([districtId, name])
    @@unique([districtId, code])
}

// MEMO SYSTEM
model Memo {
  id                    String    @id @default(cuid())
  subject               String
  body                  String    @db.Text
  memo_reference_number String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  status                String    @default("draft") // draft, sent, scheduled, archived
  scheduledFor          DateTime?

  fromId                String
  from                  User      @relation("MemosFrom", fields: [fromId], references: [id])
  to                    User[]    @relation("MemosTo")
  cc                    User[]    @relation("MemosCC")

  attachments           Attachment[]
  labels                Label[]

  current_holderId String?
  current_holder   User?    @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)

  previous_holders      User[]    @relation("PreviousHolders")
  acknowledgedBy        User[]    @relation("AcknowledgedBy")
  archivedBy            User[]    @relation("ArchivedBy")
  favoritedBy           User[]    @relation("FavoritedBy")
  flaggedBy             User[]    @relation("FlaggedBy")
  
  replyToId             String?
  replyTo               Memo?     @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]    @relation("Replies")
  
  forwardFromId         String?

  activity              Activity[]

  @@index([fromId])
  @@index([current_holderId])
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  avatar              String?
  signature           String?
  hashedPassword      String?
  status              String    @default("active") // active, inactive
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int       @default(0)
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roleId              String?
  role                Role?     @relation(fields: [roleId], references: [id])

  officeId            String?
  office              Office?   @relation(fields: [officeId], references: [id])
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  divisionId          String?
  division            Division? @relation(fields: [divisionId], references: [id])
  districtId          String?
  district            District? @relation(fields: [districtId], references: [id])
  branchId            String?
  branch              Branch?   @relation(fields: [branchId], references: [id])

  memosFrom           Memo[]    @relation("MemosFrom")
  memosTo             Memo[]    @relation("MemosTo")
  memosCC             Memo[]    @relation("MemosCC")
  acknowledgedMemos   Memo[]    @relation("AcknowledgedBy")
  archivedMemos       Memo[]    @relation("ArchivedBy")
  favoritedMemos      Memo[]    @relation("FavoritedBy")
  flaggedMemos        Memo[]    @relation("FlaggedBy")
  
  activities          Activity[]
  previousHolderOf    Memo[]    @relation("PreviousHolders")
  currentHolderOf     Memo[]    @relation("CurrentHolder")

  sessions            Session[]
  accounts            Account[]

  @@index([roleId])
  @@index([officeId])
  @@index([departmentId])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  permissions String
  users       User[]
}

model Attachment {
  id        String  @id @default(cuid())
  name      String
  type      String
  url       String
  size      Int
  
  memoId    String
  memo      Memo    @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Label {
  id      String  @id @default(cuid())
  name    String  @unique
  color   String
  type    String  @default("USER") // USER or SYSTEM
  memos   Memo[]
}

model Activity {
  id          String   @id @default(cuid())
  action      String   // sent, viewed, acknowledged, forwarded, replied, commented
  timestamp   DateTime @default(now())
  details     String?  @db.Text
  ipAddress   String?
  userAgent   String?

  memoId      String
  memo        Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([memoId])
  @@index([actorId])
}

model Setting {
  key       String @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
