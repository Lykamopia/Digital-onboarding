
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// User and Session models for NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  email               String?      @unique
  emailVerified       DateTime?
  image               String?
  avatar              String?
  hashedPassword      String?
  mustChangePassword  Boolean      @default(false)
  status              String       @default("active")
  accounts            Account[]
  sessions            Session[]
  sent_memos          Memo[]       @relation("FromUser")
  received_memos      Memo[]       @relation("ToUser")
  cc_memos            Memo[]       @relation("CcUser")
  current_memo_holder Memo[]       @relation("CurrentHolder")
  previous_memo_holder Memo[]      @relation("PreviousHolders")
  acknowledged_memos  Memo[]       @relation("AcknowledgedBy")
  archivedMemos       Memo[]       @relation("ArchivedBy")
  activities          Activity[]
  roleId              String
  role                Role         @relation(fields: [roleId], references: [id])
  officeId            String
  office              Office       @relation(fields: [officeId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// Application-specific models
model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String       
  subject               String
  body                  String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  status                String       @default("draft") // draft, sent, read, acknowledged
  
  fromId                String
  from                  User         @relation("FromUser", fields: [fromId], references: [id])
  
  to                    User[]       @relation("ToUser")
  cc                    User[]       @relation("CcUser")

  current_holderId      String?
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])

  previous_holders      User[]       @relation("PreviousHolders")
  acknowledgedBy        User[]       @relation("AcknowledgedBy")
  
  archivedBy            User[]       @relation("ArchivedBy")

  attachments           Attachment[]
  activity              Activity[]

  replyToId             String?
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]       @relation("Replies")

  @@index([fromId])
  @@index([current_holderId])
}


model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  
  @@index([memoId])
}

model Activity {
  id        String     @id @default(cuid())
  memoId    String
  memo      Memo       @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User       @relation(fields: [actorId], references: [id])
  action    String // sent, viewed, acknowledged, commented, forwarded
  details   String?
  timestamp DateTime   @default(now())
  
  @@index([memoId])
  @@index([actorId])
}


// Organizational Structure
model Division {
    id          String @id @default(cuid())
    name        String @unique
    code        String @unique
    departments Department[]
}

model Department {
    id          String @id @default(cuid())
    name        String @unique
    code        String @unique
    divisionId  String
    division    Division @relation(fields: [divisionId], references: [id])
    offices     Office[]
}

model Office {
    id            String @id @default(cuid())
    name          String @unique
    code          String @unique
    departmentId  String
    department    Department @relation(fields: [departmentId], references: [id])
    users         User[]
}

model Role {
    id          String @id @default(cuid())
    name        String @unique
    permissions String // Comma-separated list of permission strings
    users       User[]
}
