
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String      @id @default(cuid())
  name                  String?
  email                 String?     @unique
  emailVerified         DateTime?
  image                 String?
  hashedPassword        String?
  avatar                String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  status                String      @default("active")
  mustChangePassword    Boolean     @default(true)

  roleId                String?
  role                  Role?       @relation(fields: [roleId], references: [id])

  officeId              String?
  office                Office?     @relation(fields: [officeId], references: [id])

  sentMemos             Memo[]      @relation("SentMemos")
  receivedMemos         Memo[]      @relation("ReceivedMemos")
  ccMemos               Memo[]      @relation("CcMemos")
  acknowledgedMemos     Memo[]      @relation("AcknowledgedMemos")
  archivedMemos         Memo[]      @relation("ArchivedMemos")
  
  currentMemoHolder     Memo?       @relation("CurrentMemoHolder", fields: [currentMemoHolderId], references: [id])
  currentMemoHolderId   String?     @unique
  previousMemoHolders   Memo[]      @relation("PreviousMemoHolders")
  
  activities            Activity[]
}

model Division {
    id          String @id @default(cuid())
    name        String
    code        String @unique
    departments Department[]
}

model Department {
    id         String @id @default(cuid())
    name       String
    code       String @unique
    division   Division @relation(fields: [divisionId], references: [id])
    divisionId String
    offices    Office[]
}

model Office {
    id           String @id @default(cuid())
    name         String
    code         String @unique
    department   Department @relation(fields: [departmentId], references: [id])
    departmentId String
    users        User[]
}

model Role {
    id          String @id @default(cuid())
    name        String @unique
    permissions String // comma-separated list of permissions
    users       User[]
}

enum MemoStatus {
  draft
  sent
  read
  acknowledged
}

model Memo {
    id                      String @id @default(cuid())
    memo_reference_number   String
    subject                 String
    body                    String
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt
    status                  MemoStatus

    from                    User @relation("SentMemos", fields: [fromId], references: [id])
    fromId                  String
    
    to                      User[] @relation("ReceivedMemos")
    cc                      User[] @relation("CcMemos")

    current_holder          User? @relation("CurrentMemoHolder")
    current_holderId        String?
    previous_holders        User[] @relation("PreviousMemoHolders")
    
    attachments             Attachment[]
    activity                Activity[]

    acknowledgedBy          User[] @relation("AcknowledgedMemos")
    archivedBy              User[] @relation("ArchivedMemos")
    
    replyTo                 Memo? @relation("replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    replyToId               String?
    replies                 Memo[] @relation("replies")
}

model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId  String
}

enum ActionType {
  sent
  viewed
  commented
  forwarded
  acknowledged
  archived
  unarchived
  created
  replied
}

model Activity {
  id        String     @id @default(cuuid())
  actor     User       @relation(fields: [actorId], references: [id])
  actorId   String
  action    ActionType
  timestamp DateTime   @default(now())
  details   String?
  memo      Memo       @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId    String
}
