// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  hashedPassword     String?
  mustChangePassword Boolean   @default(true)
  status             String    @default("active") // active, inactive
  accounts           Account[]
  sessions           Session[]

  roleId  String
  role    Role    @relation(fields: [roleId], references: [id])
  officeId String
  office   Office  @relation(fields: [officeId], references: [id])

  memosSent          Memo[]       @relation("MemosSent")
  memosReceived      Memo[]       @relation("MemosReceived")
  memosCc            Memo[]       @relation("MemosCc")
  currentMemoHolder  Memo?        @relation("CurrentHolder")
  previousMemoHolder Memo[]       @relation("PreviousHolders")
  acknowledgedMemos  Memo[]       @relation("AcknowledgedMemos")
  archivedMemos      Memo[]       @relation("ArchivedMemos")
  activities         Activity[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // Comma-separated list of permissions
  users       User[]
}

model Division {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  departments Department[]
}

model Department {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])
  offices    Office[]
}

model Branch {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  districts District[]
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  code     String   @unique
  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id])
  offices  Office[]
}

model Office {
  id           String      @id @default(cuid())
  name         String      @unique
  code         String      @unique
  type         String // 'division' or 'branch'
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  districtId   String?
  district     District?   @relation(fields: [districtId], references: [id])
  users        User[]
}

model Memo {
  id                      String       @id @default(cuid())
  memo_reference_number   String?      @unique
  subject                 String
  body                    String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  status                  String       @default("draft") // draft, sent, acknowledged, etc.
  
  fromId           String
  from             User         @relation("MemosSent", fields: [fromId], references: [id])
  to               User[]       @relation("MemosReceived")
  cc               User[]       @relation("MemosCc")

  current_holderId    String?
  current_holder      User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders    User[]       @relation("PreviousHolders")

  acknowledgedBy      User[]       @relation("AcknowledgedMemos")
  archivedBy          User[]       @relation("ArchivedMemos")
  
  attachments    Attachment[]
  activity       Activity[]

  replyToId      String?
  replyTo        Memo?          @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        Memo[]         @relation("Replies")
}


model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  details   String?

  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id])
  actorId String
  actor   User   @relation(fields: [actorId], references: [id])
}
