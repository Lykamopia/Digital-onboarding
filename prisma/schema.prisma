
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Memo {
  id                      String   @id @default(cuid())
  memo_reference_number   String?  @unique
  subject                 String
  body                    String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  status                  MemoStatus @default(draft)
  scheduledFor            DateTime?

  fromId                  String
  from                    User     @relation("AuthoredMemos", fields: [fromId], references: [id])
  
  to                      User[]   @relation("SentTo")
  cc                      User[]   @relation("SentToCC")

  current_holderId        String?
  current_holder          User?    @relation("CurrentHolder", fields: [current_holderId], references: [id])
  
  previous_holders        User[]   @relation("PreviousHolders")

  acknowledgedBy          User[]   @relation("AcknowledgedMemos")

  attachments             Attachment[]
  activity                Activity[]
  
  archivedBy              User[]      @relation("ArchivedMemos")
  favoritedBy             User[]      @relation("FavoriteMemos")

  labels                  Label[]     @relation("MemoLabels")

  replies                 Memo[]      @relation("MemoReplies")
  replyToId               String?
  replyTo                 Memo?       @relation("MemoReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Label {
  id      String   @id @default(cuid())
  name    String   @unique
  color   String
  type    LabelType @default(USER)
  memos   Memo[]   @relation("MemoLabels")
}

enum LabelType {
  SYSTEM
  USER
}

model Attachment {
  id      String   @id @default(cuid())
  memoId  String
  memo    Memo     @relation(fields: [memoId], references: [id])
  name    String
  url     String
  type    String
  size    Int
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model User {
  id                  String   @id @default(cuid())
  name                String?
  email               String   @unique
  emailVerified       DateTime?
  image               String?
  avatar              String?
  hashedPassword      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  mustChangePassword  Boolean  @default(false)
  status              String   @default("active") // active, inactive

  sentMemos           Memo[]   @relation("AuthoredMemos")
  memosTo             Memo[]   @relation("SentTo")
  memosCc             Memo[]   @relation("SentToCC")
  
  memosAsCurrentHolder Memo[] @relation("CurrentHolder")
  memosAsPreviousHolder Memo[] @relation("PreviousHolders")

  acknowledgedMemos   Memo[]   @relation("AcknowledgedMemos")
  archivedMemos       Memo[]   @relation("ArchivedMemos")
  favoriteMemos       Memo[]   @relation("FavoriteMemos")

  roleId              String
  role                Role     @relation(fields: [roleId], references: [id])

  officeId            String
  office              Office   @relation(fields: [officeId], references: [id])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String
  users       User[]
}

model Office {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  type        String    // head_office, division_office, branch_office, division, branch
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  officeId  String
  office    Office    @relation(fields: [officeId], references: [id])
  divisions Division[]
}

model Division {
  id            String    @id @default(cuid())
  name          String    @unique
  code          String    @unique
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
}

model District {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  officeId  String
  office    Office    @relation(fields: [officeId], references: [id])
  branches  Branch[]
}

model Branch {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  districtId  String
  district    District  @relation(fields: [districtId], references: [id])
}

enum MemoStatus {
  draft
  sent
  archived
  scheduled
}
