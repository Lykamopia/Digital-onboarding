// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memo {
  id                      String   @id @default(cuid())
  memo_reference_number   String?  @unique
  subject                 String
  body                    String   @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  status                  String
  scheduledFor            DateTime?
  isFlagged               Boolean  @default(false)

  fromId                  String
  from                    User     @relation("AuthoredMemos", fields: [fromId], references: [id])
  
  to                      User[]   @relation("SentTo")
  cc                      User[]   @relation("CcTo")

  current_holderId        String?
  current_holder          User?    @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  
  previous_holders        User[]   @relation("PreviousHolders")
  acknowledgedBy          User[]   @relation("AcknowledgedMemos")
  archivedBy              User[]   @relation("ArchivedMemos")
  favoritedBy             User[]   @relation("FavoritedMemos")


  attachments             Attachment[]
  activity                Activity[]

  // For replies
  replyToId               String?
  replyTo                 Memo?    @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies                 Memo[]   @relation("Replies")

  labels                  Label[]
}

model Label {
  id      String @id @default(cuid())
  name    String
  color   String
  type    String @default("USER") // SYSTEM or USER
  memos   Memo[]
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String    @unique
  emailVerified           DateTime?
  hashedPassword          String?
  avatar                  String?
  image                   String?   // next-auth property
  status                  String    @default("active") // active, inactive
  mustChangePassword      Boolean   @default(true)
  
  officeId                String?
  office                  Office?   @relation(fields: [officeId], references: [id])

  roleId                  String?
  role                    Role?     @relation(fields: [roleId], references: [id])

  // Relations
  authoredMemos           Memo[]    @relation("AuthoredMemos")
  memosTo                 Memo[]    @relation("SentTo")
  memosCc                 Memo[]    @relation("CcTo")

  memosAsCurrentHolder    Memo[]    @relation("CurrentHolder")
  memosAsPreviousHolder   Memo[]    @relation("PreviousHolders")
  acknowledgedMemos       Memo[]    @relation("AcknowledgedMemos")
  archivedMemos           Memo[]    @relation("ArchivedMemos")
  favoritedMemos          Memo[]    @relation("FavoritedMemos")

  accounts                Account[]
  sessions                Session[]

  activity                Activity[]
}

// next-auth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// Organizational Structure
model Office {
  id          String    @id @default(cuid())
  name        String
  code        String
  type        String // 'head_office', 'division_office', 'branch_office', 'division', 'branch'
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id       String    @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office    @relation(fields: [officeId], references: [id])
  divisions Division[]
}

model Division {
  id           String @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}

model District {
    id       String @id @default(cuid())
    name     String
    code     String
    officeId String
    office   Office   @relation(fields: [officeId], references: [id])
    branches Branch[]
}

model Branch {
    id         String @id @default(cuid())
    name       String
    code       String
    districtId String
    district   District @relation(fields: [districtId], references: [id])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String
  users       User[]
}

model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  url     String
  size    Int
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String   // e.g., 'sent', 'viewed', 'acknowledged', 'commented', 'forwarded'
  details   String?  @db.Text
  timestamp DateTime @default(now())
}
