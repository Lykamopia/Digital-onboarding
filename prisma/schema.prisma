// datasource db defines the database connection details.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// generator client defines the Prisma Client generator.
generator client {
  provider = "prisma-client-js"
}

// --- ORGANIZATIONAL STRUCTURE ---

model Division {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  departments Department[]
}

model Department {
  id         String   @id @default(cuid())
  name       String
  code       String
  division   Division @relation(fields: [divisionId], references: [id])
  divisionId String
  offices    Office[]

  @@unique([name, divisionId])
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  users        User[]

  @@unique([name, departmentId])
}

// --- USER & ROLES ---

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // Comma-separated list of permissions
  users       User[]
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  emailVerified   DateTime?
  image           String?
  avatar          String?
  hashedPassword  String?
  status          String       @default("active")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  role            Role         @relation(fields: [roleId], references: [id])
  roleId          String
  office          Office?      @relation(fields: [officeId], references: [id])
  officeId        String?
  sentMemos       Memo[]       @relation("MemoFrom")
  receivedMemos   Memo[]       @relation("MemoTo")
  ccMemos         Memo[]       @relation("MemoCc")
  heldMemos       Memo[]       @relation("MemoCurrentHolder")
  previouslyHeldMemos Memo[]   @relation("MemoPreviousHolders")
  acknowledgedMemos Memo[]     @relation("MemoAcknowledgedBy")
  archivedMemos   Memo[]       @relation("MemoArchivedBy")
  activities      Activity[]
  accounts        Account[]
  sessions        Session[]
}

// Required for NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// --- MEMO & RELATED MODELS ---

model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String
  subject               String
  body                  String
  status                String       @default("draft")
  from                  User         @relation("MemoFrom", fields: [fromId], references: [id])
  fromId                String
  to                    User[]       @relation("MemoTo")
  cc                    User[]       @relation("MemoCc")
  current_holder        User?        @relation("MemoCurrentHolder", fields: [current_holderId], references: [id])
  current_holderId      String?
  previous_holders      User[]       @relation("MemoPreviousHolders")
  acknowledgedBy        User[]       @relation("MemoAcknowledgedBy")
  archivedBy            User[]       @relation("MemoArchivedBy")
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId             String?
  replies               Memo[]       @relation("Replies")
  attachments           Attachment[]
  activity              Activity[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId String
}

model Activity {
  id        String   @id @default(cuid())
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId    String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  details   String?
  timestamp DateTime @default(now())
}
