
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String       @id @default(cuid())
  name               String?
  email              String?      @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  avatar             String?
  mustChangePassword Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  status             String       @default("active")
  accounts           Account[]
  sessions           Session[]
  sentMemos          Memo[]       @relation("FromUser")
  receivedMemos      Memo[]       @relation("ToUser")
  ccMemos            Memo[]       @relation("CcUser")
  currentMemoHolder  Memo?        @relation("CurrentHolder")
  previousMemoHolder Memo[]       @relation("PreviousHolder")
  acknowledgedMemos  Memo[]       @relation("AcknowledgedUser")
  archivedMemos      Memo[]       @relation("ArchivedUser")
  activity           Activity[]
  roleId             String?
  role               Role?        @relation(fields: [roleId], references: [id])
  officeId           String?
  office             Office?      @relation(fields: [officeId], references: [id])

  @@index([roleId])
  @@index([officeId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // Comma-separated list of permissions
  users       User[]
}

model Division {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  departments Department[]
}

model Department {
  id         String     @id @default(cuid())
  name       String
  code       String
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id])
  offices    Office[]

  @@unique([divisionId, name])
  @@index([divisionId])
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String?      @unique
  subject               String
  body                  String       @db.Text
  status                String       @default("draft") // "draft", "sent", "read", "acknowledged", "archived"
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  fromId                String
  from                  User         @relation("FromUser", fields: [fromId], references: [id])
  to                    User[]       @relation("ToUser")
  cc                    User[]       @relation("CcUser")
  attachments           Attachment[]
  activity              Activity[]
  current_holderId      String?
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders      User[]       @relation("PreviousHolder")
  acknowledgedBy        User[]       @relation("AcknowledgedUser")
  archivedBy            User[]       @relation("ArchivedUser")
  replyToId             String?
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]       @relation("Replies")

  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String @db.Text
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g., "sent", "viewed", "commented", "forwarded", "acknowledged"
  details   String?
  timestamp DateTime @default(now())

  @@index([memoId])
  @@index([actorId])
}
