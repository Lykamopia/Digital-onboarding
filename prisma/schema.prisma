// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  hashedPassword     String?
  avatar             String?
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  status             String    @default("active") // active, inactive, suspended
  mustChangePassword Boolean   @default(false)
  
  roleId             String?
  role               Role?     @relation(fields: [roleId], references: [id])

  officeId           String?
  office             Office?   @relation(fields: [officeId], references: [id])

  accounts           Account[]
  sessions           Session[]

  // Memos authored by the user
  authoredMemos      Memo[]    @relation("AuthoredMemos")

  // Memos sent TO this user
  memosTo            Memo[]    @relation("MemoTo")
  
  // Memos CC'd to this user
  memosCc            Memo[]    @relation("MemoCc")
  
  // Memo this user is currently holding
  heldMemos          Memo[] @relation("CurrentHolder")

  // Memos this user has previously held
  previouslyHeldMemos Memo[] @relation("PreviousHolder")

  // Memos acknowledged by this user
  acknowledgedMemos  Memo[]    @relation("AcknowledgedBy")
  
  // Memos archived by this user
  archivedMemos      Memo[]    @relation("ArchivedBy")

  // Activities performed by the user
  activities         Activity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Organizational Structure
model Division {
    id          String @id @default(cuid())
    name        String @unique
    code        String @unique
    departments Department[]
}

model Department {
    id         String @id @default(cuid())
    name       String
    code       String @unique
    divisionId String
    division   Division @relation(fields: [divisionId], references: [id])
    offices    Office[]
    @@unique([name, divisionId])
}

model Office {
    id           String @id @default(cuid())
    name         String
    code         String @unique
    departmentId String
    department   Department @relation(fields: [departmentId], references: [id])
    users        User[]
    @@unique([name, departmentId])
}

model Role {
    id          String @id @default(cuid())
    name        String @unique
    permissions String // comma-separated list of permissions
    users       User[]
}

// Memo Core Models
model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String       @unique
  subject               String
  body                  String       @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  status                String // e.g., draft, sent, acknowledged, archived

  fromId                String
  from                  User         @relation("AuthoredMemos", fields: [fromId], references: [id])

  to                    User[]       @relation("MemoTo")
  cc                    User[]       @relation("MemoCc")
  
  current_holderId      String?
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id], onUpdate: NoAction)

  previous_holders      User[]       @relation("PreviousHolder")

  acknowledgedBy        User[]       @relation("AcknowledgedBy")
  archivedBy            User[]       @relation("ArchivedBy")

  attachments           Attachment[]
  activity              Activity[]

  // For replies
  replies               Memo[]       @relation("Replies")
  replyToId             String?
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Explicitly manage the join tables for many-to-many
  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
}


model Attachment {
  id      String @id @default(cuid())
  name    String
  type    String
  size    Int
  url     String @db.Text
  memoId  String
  memo    Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String     @id @default(cuid())
  memoId    String
  memo      Memo       @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User       @relation(fields: [actorId], references: [id])
  action    String     // e.g., 'sent', 'viewed', 'commented', 'forwarded'
  details   String?
  timestamp DateTime   @default(now())
}
