// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String      @id @default(cuid())
  name                  String?
  email                 String?     @unique
  emailVerified         DateTime?
  hashedPassword        String?
  avatar                String?
  signature             String?
  onboardingCompleted   Boolean     @default(false)

  // Login security
  failedLoginAttempts   Int         @default(0)
  lockoutUntil          DateTime?
  tokenVersion          Int         @default(0) // Used to invalidate all tokens for a user

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  status                String      @default("active") // active, inactive

  // Relationships
  role                  Role?       @relation(fields: [roleId], references: [id])
  roleId                String?
  office                Office?     @relation(fields: [officeId], references: [id])
  officeId              String?
  department            Department? @relation(fields: [departmentId], references: [id])
  departmentId          String?
  division              Division?   @relation(fields: [divisionId], references: [id])
  divisionId            String?
  district              District?   @relation(fields: [districtId], references: [id])
  districtId            String?
  branch                Branch?     @relation(fields: [branchId], references: [id])
  branchId              String?

  sentMemos             Memo[]      @relation("SentMemos")
  receivedMemos         Memo[]      @relation("ReceivedMemos")
  ccMemos               Memo[]      @relation("CcMemos")
  currentHolderOfMemos  Memo[]      @relation("CurrentHolder")
  previousHolderOfMemos Memo[]      @relation("PreviousHolders")
  acknowledgedMemos     Memo[]      @relation("AcknowledgedMemos")
  archivedMemos         Memo[]      @relation("ArchivedMemos")
  favoritedMemos        Memo[]      @relation("FavoritedMemos")
  flaggedMemos          Memo[]      @relation("FlaggedMemos")
  activity              Activity[]
  
  delegations           Delegation[] @relation("Delegator")
  delegatedTo           Delegation[] @relation("Delegate")
}

model PasswordResetToken {
  email   String   @unique
  token   String   @unique
  expires DateTime
}

model Delegation {
  id           String   @id @default(cuid())
  delegator    User     @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegatorId  String
  delegate     User     @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)
  delegateId   String
  permissions  String
  createdAt    DateTime @default(now())

  @@unique([delegatorId, delegateId])
}


model Memo {
  id                   String   @id @default(cuid())
  memo_reference_number String? @unique
  subject              String
  body                 String   @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  status               String   @default("draft") // draft, sent, archived, scheduled
  
  scheduledFor         DateTime?

  fromId               String
  from                 User     @relation("SentMemos", fields: [fromId], references: [id], onDelete: Cascade)
  
  to                   User[]   @relation("ReceivedMemos")
  cc                   User[]   @relation("CcMemos")
  
  current_holderId     String?
  current_holder       User?    @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)

  previous_holders     User[]   @relation("PreviousHolders")
  
  acknowledgedBy       User[]   @relation("AcknowledgedMemos")

  archivedBy           User[]   @relation("ArchivedMemos")
  favoritedBy          User[]   @relation("FavoritedMemos")
  flaggedBy            User[]   @relation("FlaggedMemos")

  attachments          Attachment[]
  activity             Activity[]
  labels               Label[]

  replyToId            String?
  replyTo              Memo? @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies              Memo[] @relation("Replies")

  assignedFromId       String?
  assignedFrom         Memo? @relation("Assignments", fields: [assignedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments          Memo[] @relation("Assignments")

  @@index([fromId])
  @@index([current_holderId])
  @@index([replyToId])
  @@index([assignedFromId])
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int
  url       String
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  createdAt DateTime @default(now())

  @@index([memoId])
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([memoId])
  @@index([actorId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Office {
  id           String    @id @default(cuid())
  name         String    @unique
  code         String
  type         String
  departments  Department[]
  districts    District[]
  users        User[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String
  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  officeId  String
  divisions Division[]
  users     User[]

  @@unique([name, officeId])
}

model Division {
  id            String    @id @default(cuid())
  name          String
  code          String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId  String
  users         User[]

  @@unique([name, departmentId])
}

model District {
  id        String    @id @default(cuid())
  name      String
  code      String
  office    Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  officeId  String
  branches  Branch[]
  users     User[]
  
  @@unique([name, officeId])
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId  String
  users       User[]
  
  @@unique([name, districtId])
}

model Label {
  id     String @id @default(cuid())
  name   String @unique
  color  String
  type   String // SYSTEM, USER
  memos  Memo[]
}

model Setting {
  key   String @id
  value Json
}

model EmailLog {
    id String @id @default(cuid())
    from String
    to String
    cc String?
    subject String
    body String @db.Text
    status String // sent, failed
    errorMessage String?
    triggerEvent String // new_memo, welcome_user, etc
    relatedEntityId String?
    messageId String?
    createdAt DateTime @default(now())
}
