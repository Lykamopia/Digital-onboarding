// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  emailVerified   DateTime?
  image           String?
  hashedPassword  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  avatar          String?
  officeId        String?
  roleId          String?
  accounts        Account[]
  sessions        Session[]
  sentMemos       Memo[]       @relation("SentMemos")
  receivedMemos   Memo[]       @relation("ReceivedMemos")
  ccMemos         Memo[]       @relation("CcMemos")
  currentMemo     Memo?        @relation("CurrentHolder")
  previousMemos   Memo[]       @relation("PreviousHolders")
  acknowledgedMemos Memo[]     @relation("AcknowledgedBy")
  archivedMemos   Memo[]       @relation("ArchivedBy")
  activities      Activity[]
  office          Office?      @relation(fields: [officeId], references: [id])
  role            Role?        @relation(fields: [roleId], references: [id])
}

model Division {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  departments Department[]
}

model Department {
  id         String     @id @default(cuid())
  name       String
  code       String     @unique
  division   Division   @relation(fields: [divisionId], references: [id])
  divisionId String
  offices    Office[]
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  users        User[]
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String       @unique
  subject               String
  body                  String       @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  status                String       @default("draft") // draft, sent, read, acknowledged
  from                  User         @relation("SentMemos", fields: [fromId], references: [id])
  fromId                String
  to                    User[]       @relation("ReceivedMemos")
  cc                    User[]       @relation("CcMemos")
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  current_holderId      String?      @unique
  previous_holders      User[]       @relation("PreviousHolders")
  acknowledgedBy        User[]       @relation("AcknowledgedBy")
  archivedBy            User[]       @relation("ArchivedBy")
  attachments           Attachment[]
  activity              Activity[]
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId             String?
  replies               Memo[]       @relation("Replies")
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId String
}

model Activity {
  id        String   @id @default(cuid())
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId    String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  details   String?
  timestamp DateTime @default(now())
}

enum Permission {
  view_dashboard
  manage_memos
  view_admin
  manage_divisions
  manage_departments
  manage_offices
  manage_users
  manage_roles
  manage_archive
}
