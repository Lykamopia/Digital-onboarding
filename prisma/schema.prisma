
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  email               String?      @unique
  emailVerified       DateTime?
  image               String?
  hashedPassword      String?
  avatar              String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  mustChangePassword  Boolean      @default(true)
  status              String       @default("active") // active, inactive
  accounts            Account[]
  sessions            Session[]
  memos_authored      Memo[]       @relation("MemoFrom")
  memos_to            Memo[]       @relation("MemoTo")
  memos_cc            Memo[]       @relation("MemoCc")
  memos_acknowledged  Memo[]       @relation("AcknowledgedBy")
  memos_archived      Memo[]       @relation("ArchivedBy")
  memos_held          Memo[]       @relation("PreviousHolders")
  memos_currently_holding Memo[]   @relation("CurrentHolder") // This defines the one-to-many from the User side
  role                Role?        @relation(fields: [roleId], references: [id])
  roleId              String?
  office              Office?      @relation(fields: [officeId], references: [id])
  officeId            String?
  activities          Activity[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String // comma-separated list
  users       User[]
}

model Division {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  departments Department[]
}

model Department {
  id         String    @id @default(cuid())
  name       String    @unique
  code       String    @unique
  division   Division  @relation(fields: [divisionId], references: [id])
  divisionId String
  offices    Office[]
}

model Branch {
    id        String     @id @default(cuid())
    name      String     @unique
    code      String     @unique
    districts District[]
}

model District {
    id       String   @id @default(cuid())
    name     String   @unique
    code     String   @unique
    branch   Branch   @relation(fields: [branchId], references: [id])
    branchId String
    offices  Office[]
}

model Office {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  type         String // "division" or "branch"
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  district     District?   @relation(fields: [districtId], references: [id])
  districtId   String?
  users        User[]
}

model Memo {
  id                      String       @id @default(cuid())
  memo_reference_number   String?      @unique
  subject                 String
  body                    String
  status                  String       @default("draft") // draft, sent, read, acknowledged
  from                    User         @relation("MemoFrom", fields: [fromId], references: [id])
  fromId                  String
  to                      User[]       @relation("MemoTo")
  cc                      User[]       @relation("MemoCc")
  current_holderId        String?
  current_holder          User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders        User[]       @relation("PreviousHolders")
  acknowledgedBy          User[]       @relation("AcknowledgedBy")
  archivedBy              User[]       @relation("ArchivedBy")
  attachments             Attachment[]
  activity                Activity[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  replies                 Memo[]       @relation("MemoReplies")
  replyTo                 Memo?        @relation("MemoReplies", fields: [replyToId], references: [id])
  replyToId               String?
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memo   Memo   @relation(fields: [memoId], references: [id])
  memoId String
}

model Activity {
  id        String   @id @default(cuid())
  memo      Memo     @relation(fields: [memoId], references: [id])
  memoId    String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String // e.g., 'sent', 'viewed', 'acknowledged', 'forwarded', 'commented'
  details   String?
  timestamp DateTime @default(now())
}
