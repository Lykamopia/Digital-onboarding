// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String?   @unique
  emailVerified           DateTime?
  image                   String?
  hashedPassword          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  sessions                Session[]
  accounts                Account[]
  
  mustChangePassword      Boolean   @default(true)
  status                  String    @default("active") // active, inactive
  avatar                  String?
  signature               String?   

  officeId                String?
  office                  Office?   @relation(fields: [officeId], references: [id])

  roleId                  String?
  role                    Role?     @relation(fields: [roleId], references: [id])
  
  sentMemos               Memo[]    @relation("SentMemos")
  receivedMemos           Memo[]    @relation("ReceivedMemos")
  ccMemos                 Memo[]    @relation("CcMemos")
  currentHolderOfMemos    Memo[]    @relation("CurrentHolder")
  previousHolderOfMemos   Memo[]    @relation("PreviousHolders")
  acknowledgedMemos       Memo[]    @relation("AcknowledgedMemos")
  archivedMemos           Memo[]    @relation("ArchivedMemos")
  favoritedMemos          Memo[]    @relation("FavoritedMemos")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? 
  access_token       String? 
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? 
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OfficeType {
  head_office
  division_office
  branch_office
  division
  branch
}

model Office {
  id          String @id @default(cuid())
  name        String
  code        String @unique
  type        OfficeType

  users       User[]
  departments Department[]
  districts   District[]
}

model Department {
  id          String @id @default(cuid())
  name        String
  code        String @unique
  
  officeId    String
  office      Office @relation(fields: [officeId], references: [id])
  
  divisions   Division[]
}

model Division {
  id           String @id @default(cuid())
  name         String
  code         String @unique
  
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}

model District {
    id String @id @default(cuid())
    name String
    code String @unique

    officeId String
    office Office @relation(fields: [officeId], references: [id])

    branches Branch[]
}

model Branch {
    id String @id @default(cuid())
    name String
    code String @unique

    districtId String
    district District @relation(fields: [districtId], references: [id])
}


model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // comma separated list
  users       User[]
}

model Memo {
  id                      String   @id @default(cuid())
  memo_reference_number   String?  @unique
  subject                 String
  body                    String   @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  status                  String   // e.g., "draft", "sent", "archived", "scheduled"
  scheduledFor            DateTime?
  isFlagged               Boolean  @default(false)

  fromId                  String
  from                    User     @relation("SentMemos", fields: [fromId], references: [id])

  to                      User[]   @relation("ReceivedMemos")
  cc                      User[]   @relation("CcMemos")
  
  current_holderId        String?
  current_holder          User?    @relation("CurrentHolder", fields: [current_holderId], references: [id])

  previous_holders        User[]    @relation("PreviousHolders")
  acknowledgedBy          User[]    @relation("AcknowledgedMemos")
  archivedBy              User[]    @relation("ArchivedMemos")
  favoritedBy             User[]    @relation("FavoritedMemos")


  attachments             Attachment[]
  activity                Activity[]

  replyToId               String?
  replyTo                 Memo?     @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies                 Memo[]    @relation("Replies")

  labels                  Label[]
}

model Label {
  id      String  @id @default(cuid())
  name    String
  color   String
  type    String  // "SYSTEM" or "USER"
  memos   Memo[]
}


model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String   // e.g., "sent", "viewed", "commented", "forwarded"
  timestamp DateTime @default(now())
  details   String?
}
