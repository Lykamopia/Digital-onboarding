
datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  avatar             String?
  hashedPassword     String?
  mustChangePassword Boolean   @default(false)
  status             String    @default("active")
  accounts           Account[]
  sessions           Session[]

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  sentMemos      Memo[] @relation("SentMemos")
  memosTo        Memo[] @relation("MemosTo")
  memosCc        Memo[] @relation("MemosCc")
  currentMemos   Memo[] @relation("CurrentHolder")
  previousMemos  Memo[] @relation("PreviousHolders")
  acknowledged   Memo[] @relation("AcknowledgedBy")
  archivedMemos  Memo[] @relation("ArchivedBy")
  activities     Activity[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  divisions Division[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String   @unique
  officeId String
  office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  branches Branch[]
}

model Office {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  type        String // 'division' or 'branch'
  departments Department[]
  districts   District[]
  users       User[]
}

model Memo {
  id                      String       @id @default(cuid())
  memo_reference_number   String?      @unique
  subject                 String
  body                    String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  status                  String       @default("draft")

  fromId   String
  from     User   @relation("SentMemos", fields: [fromId], references: [id], onDelete: Cascade)
  to       User[] @relation("MemosTo")
  cc       User[] @relation("MemosCc")

  current_holderId    String?
  current_holder      User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders    User[]       @relation("PreviousHolders")
  acknowledgedBy      User[]       @relation("AcknowledgedBy")
  archivedBy          User[]       @relation("ArchivedBy")
  
  attachments             Attachment[]
  activity                Activity[]
  replies                 Memo[]       @relation("Replies")      
  replyToId               String?
  replyTo                 Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  details   String?
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}
