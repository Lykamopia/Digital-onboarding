
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
}


model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String?   @unique
  emailVerified           DateTime?
  image                   String?
  hashedPassword          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  mustChangePassword      Boolean   @default(false)
  status                  String    @default("active")
  avatar                  String?

  officeId                String?
  office                  Office?   @relation(fields: [officeId], references: [id])
  
  roleId                  String?
  role                    Role?     @relation(fields: [roleId], references: [id])
  
  accounts                Account[] @relation("UserAccounts")
  sessions                Session[] @relation("UserSessions")
  
  sent_memos              Memo[] @relation("SentMemos")
  memos_to                Memo[] @relation("MemosTo")
  memos_cc                Memo[] @relation("MemosCC")
  memos_acknowledged      Memo[] @relation("AcknowledgedBy")
  memosAsCurrentHolder    Memo[] @relation("CurrentHolder")
  memos_as_previous_holder Memo[] @relation("PreviousHolders")
  memos_archived          Memo[] @relation("ArchivedBy")
  favoriteMemos           Memo[] @relation("FavoritedBy")
  
  acted_in                Activity[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String
  users       User[]
}

model Office {
    id          String @id @default(cuid())
    name        String
    code        String @unique
    type        String

    departments Department[]
    districts   District[]
    users       User[]
}

model Department {
    id          String @id @default(cuid())
    name        String
    code        String @unique
    
    officeId    String
    office      Office @relation(fields: [officeId], references: [id])

    divisions   Division[]
}

model Division {
    id          String @id @default(cuid())
    name        String
    code        String @unique
    
    departmentId String
    department   Department @relation(fields: [departmentId], references: [id])
}

model District {
    id          String @id @default(cuid())
    name        String
    code        String @unique
    
    officeId    String
    office      Office @relation(fields: [officeId], references: [id])

    branches    Branch[]
}

model Branch {
    id          String @id @default(cuid())
    name        String
    code        String @unique
    
    districtId String
    district   District @relation(fields: [districtId], references: [id])
}

enum MemoStatus {
  draft
  sent
  scheduled
}

model Memo {
  id                    String      @id @default(cuid())
  memo_reference_number String?
  subject               String
  body                  String      @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  status                MemoStatus  @default(draft)
  scheduledFor          DateTime?

  fromId                String
  from                  User        @relation("SentMemos", fields: [fromId], references: [id])

  to                    User[]      @relation("MemosTo")
  cc                    User[]      @relation("MemosCC")

  current_holderId      String?
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])

  previous_holders      User[]      @relation("PreviousHolders")
  acknowledgedBy        User[]      @relation("AcknowledgedBy")
  
  attachments           Attachment[]
  activity              Activity[]
  archivedBy            User[]      @relation("ArchivedBy")
  favoritedBy           User[]      @relation("FavoritedBy")
  
  replies               Memo[]      @relation("Replies")
  replyToId             String?
  replyTo               Memo?       @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int
  url       String
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  details   String?
  timestamp DateTime @default(now())
  
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
}
