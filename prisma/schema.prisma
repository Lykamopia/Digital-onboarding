// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Permission {
  view-dashboard
  manage-memos
  view-admin
  manage-divisions
  manage-departments
  manage-offices
  manage-users
  manage-roles
}

model User {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  avatar                String?
  officeId              String
  roleId                String
  office                Office     @relation(fields: [officeId], references: [id])
  role                  Role       @relation(fields: [roleId], references: [id])
  memosFrom             Memo[]     @relation("MemosFromUser")
  memosTo               Memo[]     @relation("MemosToUser")
  memosCc               Memo[]     @relation("MemosCcUser")
  activity              Activity[]
  acknowledgedMemos     Memo[]     @relation("AcknowledgedBy")
  archivedMemos         Memo[]     @relation("ArchivedBy")
  currentHolderOfMemos  Memo[]     @relation("CurrentHolder")
  previousHolderOfMemos Memo[]     @relation("PreviousHolder")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Division {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  departments Department[]
}

model Department {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])
  offices    Office[]
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model Memo {
  id                    String       @id @default(cuid())
  memo_reference_number String       @unique
  subject               String
  body                  String
  status                String
  createdAt             DateTime     @default(now())
  fromId                String
  from                  User         @relation("MemosFromUser", fields: [fromId], references: [id])
  to                    User[]       @relation("MemosToUser")
  cc                    User[]       @relation("MemosCcUser")
  attachments           Attachment[]
  activity              Activity[]
  current_holderId      String?
  current_holder        User?        @relation("CurrentHolder", fields: [current_holderId], references: [id])
  previous_holders      User[]       @relation("PreviousHolder")
  acknowledgedBy        User[]       @relation("AcknowledgedBy")
  archivedBy            User[]       @relation("ArchivedBy")
  replyToId             String?
  replyTo               Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies               Memo[]       @relation("Replies")
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id])
}
