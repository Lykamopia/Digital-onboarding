
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Memo {
  id                      String    @id @default(cuid())
  memo_reference_number   String?   @unique
  subject                 String
  body                    String    @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  status                  String    @default("draft") // draft, sent, scheduled
  scheduledFor            DateTime?
  
  fromId                  String
  from                    User      @relation("SentMemos", fields: [fromId], references: [id])
  
  to                      User[]    @relation("ReceivedMemos")
  cc                      User[]    @relation("CcMemos")

  attachments             Attachment[]
  activity                Activity[]
  
  current_holderId        String?
  current_holder          User?     @relation("HeldMemos", fields: [current_holderId], references: [id])
  
  previous_holders        User[]    @relation("PreviouslyHeldMemos")

  acknowledgedBy          User[]    @relation("AcknowledgedMemos")
  
  // For soft-delete/archiving
  archivedBy              User[]    @relation("ArchivedMemos")
  
  favoritedBy             User[]    @relation("FavoritedMemos")
  flaggedBy               User[]    @relation("FlaggedMemos")

  labels                  Label[]   @relation("MemoLabels")

  // For threading replies
  replyToId               String?
  replyTo                 Memo?     @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies                 Memo[]    @relation("Replies")

  // For tracking forwards
  forwardFromId           String?
}

model Attachment {
  id        String @id @default(cuid())
  name      String
  type      String
  size      Int
  url       String
  memoId    String
  memo      Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g., 'sent', 'viewed', 'acknowledged', 'forwarded', 'commented'
  details   String?
  timestamp DateTime @default(now())
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  avatar                String?
  signature             String?
  hashedPassword        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  status                String    @default("active") // active, inactive
  mustChangePassword    Boolean?  @default(true)
  failedLoginAttempts   Int       @default(0)
  lockoutUntil          DateTime?
  tokenVersion          Int       @default(0)

  // Relations
  sentMemos             Memo[]    @relation("SentMemos")
  receivedMemos         Memo[]    @relation("ReceivedMemos")
  ccMemos               Memo[]    @relation("CcMemos")
  heldMemos             Memo[]    @relation("HeldMemos")
  previouslyHeldMemos   Memo[]    @relation("PreviouslyHeldMemos")
  acknowledgedMemos     Memo[]    @relation("AcknowledgedMemos")
  archivedMemos         Memo[]    @relation("ArchivedMemos")
  favoritedMemos        Memo[]    @relation("FavoritedMemos")
  flaggedMemos          Memo[]    @relation("FlaggedMemos")

  activities            Activity[]

  roleId                String?
  role                  Role?     @relation(fields: [roleId], references: [id])

  officeId              String?
  office                Office?   @relation(fields: [officeId], references: [id])
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id])
  divisionId            String?
  division              Division? @relation(fields: [divisionId], references: [id])
  districtId            String?
  district              District? @relation(fields: [districtId], references: [id])
  branchId              String?
  branch                Branch? @relation(fields: [branchId], references: [id])

  accounts              Account[]
}

model Role {
    id          String @id @default(cuid())
    name        String @unique
    permissions String
    users       User[]
}

model Office {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  type        String // 'division_office', 'branch_office'
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String
  officeId    String
  office      Office    @relation(fields: [officeId], references: [id])
  divisions   Division[]
  users       User[]
}

model Division {
  id            String      @id @default(cuid())
  name          String
  code          String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  users         User[]
}

model District {
  id        String    @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office    @relation(fields: [officeId], references: [id])
  branches  Branch[]
  users     User[]
}

model Branch {
  id          String    @id @default(cuid())
  name        String
  code        String
  districtId  String
  district    District  @relation(fields: [districtId], references: [id])
  users       User[]
}

model Label {
    id      String @id @default(cuid())
    name    String
    color   String
    type    String @default("USER") // SYSTEM or USER
    memos   Memo[] @relation("MemoLabels")
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
