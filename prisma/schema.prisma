// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Memo {
  id                      String       @id @default(cuid())
  memo_reference_number   String?      @unique
  subject                 String
  body                    String       @db.Text
  status                  String       @default("draft") // Changed from MemoStatus
  fromId                  String
  from                    User         @relation("SentMemos", fields: [fromId], references: [id])
  to                      User[]       @relation("MemosTo")
  cc                      User[]       @relation("MemosCc")
  attachments             Attachment[]
  activity                Activity[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  replies                 Memo[]       @relation("Replies")
  replyTo                 Memo?        @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId               String?
  scheduledFor            DateTime?
  current_holderId        String?
  current_holder          User?        @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  previous_holders        User[]       @relation("PreviousHolders")
  acknowledgedBy          User[]       @relation("AcknowledgedMemos")
  archivedBy              User[]       @relation("ArchivedMemos")
  favoritedBy             User[]       @relation("FavoritedMemos")
  labels                  Label[]      @relation("MemoLabels")
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  type      String
  url       String
  size      Int
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Label {
  id     String @id @default(cuid())
  name   String @unique
  color  String
  type   String // Changed from LabelType
  memos  Memo[] @relation("MemoLabels")
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model User {
  id                      String       @id @default(cuid())
  name                    String
  email                   String       @unique
  hashedPassword          String?
  avatar                  String?
  roleId                  String
  role                    Role         @relation(fields: [roleId], references: [id])
  officeId                String
  office                  Office       @relation(fields: [officeId], references: [id])
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  sentMemos               Memo[]       @relation("SentMemos")
  memosTo                 Memo[]       @relation("MemosTo")
  memosCc                 Memo[]       @relation("MemosCc")
  acknowledgedMemos       Memo[]       @relation("AcknowledgedMemos")
  archivedMemos           Memo[]       @relation("ArchivedMemos")
  memosAsCurrentHolder    Memo[]       @relation("CurrentHolder")
  memosAsPreviousHolder   Memo[]       @relation("PreviousHolders")
  mustChangePassword      Boolean      @default(false)
  status                  String       @default("active")
  favoriteMemos           Memo[]       @relation("FavoritedMemos")
  activity                Activity[]
}

model Office {
  id            String        @id @default(cuid())
  name          String
  code          String
  type          String // e.g., 'division_office', 'branch_office', 'head_office', 'division', 'branch'
  users         User[]
  departments   Department[]
  districts     District[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id])
  divisions Division[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office   @relation(fields: [officeId], references: [id])
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String
  users       User[]
}
