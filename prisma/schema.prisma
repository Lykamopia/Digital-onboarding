// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Division {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  departments Department[]
}

model Department {
  id         String     @id @default(cuid())
  name       String
  code       String     @unique
  division   Division   @relation(fields: [divisionId], references: [id])
  divisionId String
  offices    Office[]
}

model Office {
  id           String     @id @default(cuid())
  name         String
  code         String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  users        User[]
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  avatar          String?
  office          Office  @relation(fields: [officeId], references: [id])
  officeId        String
  role            Role    @relation(fields: [roleId], references: [id])
  roleId          String
  memosFrom       Memo[]  @relation("MemosFrom")
  memosTo         Memo[]  @relation("MemosTo")
  memosCC         Memo[]  @relation("MemosCC")
  currentMemos    Memo[]  @relation("CurrentHolder")
  previousMemos   Memo[]  @relation("PreviousHolders")
  acknowledged    Memo[]  @relation("AcknowledgedBy")
  archivedMemos   Memo[]  @relation("ArchivedBy")
  activities      Activity[]
}

model Memo {
  id                    String      @id @default(cuid())
  memo_reference_number String      @unique
  subject               String
  body                  String
  status                String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  from                  User        @relation("MemosFrom", fields: [fromId], references: [id])
  fromId                String
  to                    User[]      @relation("MemosTo")
  cc                    User[]      @relation("MemosCC")
  current_holder        User?       @relation("CurrentHolder", fields: [current_holderId], references: [id])
  current_holderId      String?
  previous_holders      User[]      @relation("PreviousHolders")
  acknowledgedBy        User[]      @relation("AcknowledgedBy")
  archivedBy            User[]      @relation("ArchivedBy")
  replyTo               Memo?       @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replyToId             String?
  replies               Memo[]      @relation("Replies")
  attachments           Attachment[]
  activity              Activity[]
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId String
}

model Activity {
  id        String   @id @default(cuid())
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  memoId    String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  details   String?
  timestamp DateTime @default(now())
}

enum Permission {
  view_dashboard
  manage_memos
  view_admin
  manage_divisions
  manage_departments
  manage_offices
  manage_users
  manage_roles
  manage_archive
}
