// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  avatar         String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  status         String    @default("active") // active, inactive, suspended

  roleId    String
  role      Role      @relation(fields: [roleId], references: [id])
  officeId  String?
  office    Office?   @relation(fields: [officeId], references: [id])

  sentMemos      Memo[] @relation("MemoFrom")
  receivedMemos  Memo[] @relation("MemoTo")
  ccMemos        Memo[] @relation("MemoCc")
  heldMemos      Memo[] @relation("MemoHolder")
  previouslyHeldMemos Memo[] @relation("MemoPreviousHolders")
  acknowledgedMemos Memo[] @relation("MemoAcknowledgedBy")
  archivedMemos  Memo[] @relation("MemoArchivedBy")

  activities Activity[] @relation("ActivityActor")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Division {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  departments  Department[]
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String
  divisionId  String
  division    Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  offices     Office[]
}

model Office {
  id            String     @id @default(cuid())
  name          String
  code          String
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users         User[]
}

model Memo {
  id                    String   @id @default(cuid())
  memo_reference_number String
  subject               String
  body                  String   @db.Text
  status                String   @default("draft") // draft, sent, read, acknowledged, forwarded
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  fromId String
  from   User   @relation("MemoFrom", fields: [fromId], references: [id])

  to User[] @relation("MemoTo")
  cc User[] @relation("MemoCc")

  current_holderId String?
  current_holder   User?   @relation("MemoHolder", fields: [current_holderId], references: [id])

  previous_holders User[] @relation("MemoPreviousHolders")
  acknowledgedBy   User[] @relation("MemoAcknowledgedBy")
  archivedBy       User[] @relation("MemoArchivedBy")

  attachments Attachment[]
  activity    Activity[]

  replyToId String?
  replyTo   Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Memo[]  @relation("Replies")
}


model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  action    String // sent, viewed, acknowledged, forwarded, commented
  timestamp DateTime @default(now())
  details   String?

  actorId String
  actor   User   @relation("ActivityActor", fields: [actorId], references: [id])

  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

enum Permission {
  view_dashboard
  manage_memos
  view_admin
  manage_divisions
  manage_departments
  manage_offices
  manage_users
  manage_roles
  manage_archive
}
