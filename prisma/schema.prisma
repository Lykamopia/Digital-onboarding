datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Office {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  type        String
  departments Department[]
  districts   District[]
  users       User[]
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String
  officeId  String
  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  divisions Division[]
  users     User[]
}

model Division {
  id           String     @id @default(cuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
}

model District {
  id       String   @id @default(cuid())
  name     String
  code     String
  officeId String
  office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  branches Branch[]
  users    User[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  users      User[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String
  users       User[]
}

model Label {
  id    String @id @default(cuid())
  name  String
  color String
  type  String
  memos Memo[] @relation("MemoLabels")
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  avatar              String?
  signature           String?
  hashedPassword      String?
  mustChangePassword  Boolean   @default(false)
  status              String    @default("active")
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roleId     String?
  role       Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  officeId   String?
  office     Office?   @relation(fields: [officeId], references: [id], onDelete: SetNull)
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  sentMemos           Memo[] @relation("SentMemos")
  memosTo             Memo[] @relation("MemosTo")
  memosCc             Memo[] @relation("MemosCc")
  currentMemoHolder   Memo?  @relation("CurrentHolder")
  previousMemoHolders Memo[] @relation("PreviousHolders")
  acknowledgedMemos   Memo[] @relation("AcknowledgedBy")
  archivedMemos       Memo[] @relation("ArchivedBy")
  favoritedMemos      Memo[] @relation("FavoritedBy")
  flaggedMemos        Memo[] @relation("FlaggedBy")

  activities Activity[]
  accounts   Account[]
  sessions   Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Memo {
  id        String   @id @default(cuid())
  memo_reference_number String?
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String
  scheduledFor DateTime?

  fromId String
  from   User   @relation("SentMemos", fields: [fromId], references: [id], onDelete: Cascade)

  to User[] @relation("MemosTo")
  cc User[] @relation("MemosCc")

  current_holderId String?
  current_holder   User?    @relation("CurrentHolder", fields: [current_holderId], references: [id], onDelete: SetNull)

  previous_holders User[]   @relation("PreviousHolders")
  acknowledgedBy   User[]   @relation("AcknowledgedBy")
  archivedBy       User[]   @relation("ArchivedBy")
  favoritedBy      User[]   @relation("FavoritedBy")
  flaggedBy        User[]   @relation("FlaggedBy")

  attachments Attachment[]
  activity    Activity[]
  labels      Label[]      @relation("MemoLabels")

  replyToId String?
  replyTo   Memo?   @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Memo[]  @relation("Replies")

  forwardFromId String?
}

model Attachment {
  id     String @id @default(cuid())
  name   String
  type   String
  size   Int
  url    String
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?
}

model Setting {
  key   String @id
  value Json
}
